      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap');\n  :root {\n    --paper: #FDFBF7;\n    --paper-soft: #F6F1EA;\n    --card: #FFFFFF;\n    --ink: #2C2A28;\n    --muted: #5E5955;\n    --faint: #6C6259;\n    --ochre: #D48C46;\n    --ochre-soft: #F3E3D1;\n    --sage: #4A7C73;\n    --sage-soft: #E3EFEB;\n    --line: #E9E2DA;\n  }\n  .cozia-story { font-family: 'Manrope', sans-serif; color: var(--ink); background: var(--paper); }\n  .cozia-story-display { font-family: 'Fraunces', serif; }\n  .cozia-story a:focus-visible, .cozia-story button:focus-visible { outline: 2px solid var(--sage); outline-offset: 4px; }\n  .cozia-story img { display: block; }\n  @media (max-width: 767px) {\n    .story-hero-copy { background: linear-gradient(180deg, transparent 18%, rgba(44,42,40,.92) 72%, rgba(44,42,40,.98) 100%); }\n  }\n</style>\n<div class=\"cozia-story min-h-screen overflow-hidden\" data-kid=\"1\" data-name=\"Cozia Journal landing page\">\n    <header class=\"relative z-20 border-b border-[var(--line)] bg-[rgba(253,251,247,.92)]\" data-kid=\"1-1\" data-name=\"landing page header\">\n        <div class=\"mx-auto flex min-h-[76px] max-w-[1240px] items-center gap-6 px-5 py-3 sm:px-8 lg:px-10\" data-kid=\"1-1-1\" data-name=\"header content container\">\n            <a aria-label=\"Cozia home\" class=\"cozia-story-display shrink-0 rounded-lg px-1 py-1 text-[27px] font-semibold tracking-[-0.04em]\" data-kid=\"1-1-1-1\" data-name=\"site logo link\" href=\"#top\">\n                Cozia\n                <span class=\"text-[var(--ochre)]\" data-kid=\"1-1-1-1-1\" data-name=\"logo period icon\">\n                    .\n                </span>\n            </a>\n            <nav aria-label=\"Landing page navigation\" class=\"hidden items-center gap-5 lg:flex\" data-kid=\"1-1-1-2\" data-name=\"landing page navigation menu\">\n                <a class=\"rounded-lg px-2 py-2 text-sm font-semibold text-[var(--ink)]\" data-kid=\"1-1-1-2-1\" data-name=\"discover navigation link\" href=\"#discover\">\n                    Discover\n                </a>\n                <a class=\"rounded-lg px-2 py-2 text-sm font-medium text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-2\" data-name=\"our promise navigation link\" href=\"#promise\">\n                    Our promise\n                </a>\n                <a class=\"rounded-lg px-2 py-2 text-sm font-medium text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-3\" data-name=\"for families navigation link\" href=\"#families\">\n                    For families\n                </a>\n            </nav>\n            <div class=\"ml-auto flex items-center gap-3\" data-kid=\"1-1-1-3\" data-name=\"header actions container\">\n                <a class=\"hidden min-h-11 items-center rounded-lg px-3 py-2 text-sm font-semibold text-[var(--muted)] hover:text-[var(--ink)] sm:inline-flex\" data-kid=\"1-1-1-3-1\" data-name=\"sign in action link\" href=\"#signin\">\n                    Sign in\n                </a>\n                <a class=\"inline-flex min-h-11 items-center justify-center rounded-full bg-[var(--ochre)] px-5 text-sm font-bold text-white shadow-[0_6px_16px_rgba(212,140,70,.18)] hover:bg-[#c47b35]\" data-kid=\"1-1-1-3-2\" data-name=\"join cozia primary action button\" href=\"#start\">\n                    Join Cozia\n                </a>\n                <button aria-label=\"Open menu\" class=\"inline-flex min-h-11 min-w-11 items-center justify-center rounded-full border border-[var(--line)] bg-white text-lg text-[var(--ink)] lg:hidden\" data-kid=\"1-1-1-3-3\" data-name=\"open menu hamburger button\" type=\"button\">\n                    ☰\n                </button>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main page content\" id=\"top\">\n        <section aria-labelledby=\"hero-title\" class=\"relative min-h-[690px] overflow-hidden bg-[#5b5148] sm:min-h-[730px]\" data-kid=\"1-2-1\" data-name=\"landing hero section\" id=\"discover\">\n            <img alt=\"Family watching a movie together on a cozy couch, by Vitaly Gariev on Unsplash\" class=\"absolute inset-0 h-full w-full object-cover\" data-kid=\"1-2-1-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" onerror=\"this.style.display='none'\" src=\"https://images.unsplash.com/photo-1758687125866-6b9d86d41cc5?auto=format&w=1800&q=80&fit=crop\"/>\n            <div class=\"absolute inset-0 bg-gradient-to-r from-[rgba(44,42,40,.88)] via-[rgba(44,42,40,.38)] to-transparent\" data-kid=\"1-2-1-2\" data-name=\"hero gradient overlay layer\">\n            </div>\n            <div class=\"absolute inset-x-0 bottom-0 h-52 bg-gradient-to-t from-[var(--paper)] via-[rgba(253,251,247,.78)] to-transparent\" data-kid=\"1-2-1-3\" data-name=\"hero bottom fade gradient\">\n            </div>\n            <div class=\"story-hero-copy absolute inset-0 flex items-end px-5 pb-32 pt-20 sm:px-10 sm:pb-36 lg:px-[calc((100vw-1160px)/2)] lg:pb-40\" data-kid=\"1-2-1-4\" data-name=\"hero copy container\">\n                <div class=\"max-w-[680px] text-white\" data-kid=\"1-2-1-4-1\" data-name=\"hero text content block\">\n                    <p class=\"mb-5 text-xs font-bold uppercase tracking-[.2em] text-[#F7D8B5]\" data-kid=\"1-2-1-4-1-1\" data-name=\"hero subheadline label\">\n                        A calmer corner of the internet\n                    </p>\n                    <h1 class=\"cozia-story-display max-w-[680px] text-5xl leading-[.94] tracking-[-.05em] sm:text-7xl lg:text-[92px]\" data-kid=\"1-2-1-4-1-2\" data-name=\"hero main headline\" id=\"hero-title\">\n                        Find something worth sharing.\n                    </h1>\n                    <p class=\"mt-6 max-w-[470px] text-base leading-7 text-white/85 sm:text-lg\" data-kid=\"1-2-1-4-1-3\" data-name=\"hero description text\">\n                        A thoughtful home for family-safe video, made for the moments you want to remember.\n                    </p>\n                    <div class=\"mt-8 flex flex-col gap-3 sm:flex-row\" data-kid=\"1-2-1-4-1-4\" data-name=\"hero actions container\">\n                        <a class=\"inline-flex min-h-12 items-center justify-center rounded-full bg-white px-6 text-sm font-bold text-[var(--ink)] shadow-lg hover:bg-[#fff7ef]\" data-kid=\"1-2-1-4-1-4-1\" data-name=\"start exploring button\" href=\"#start\">\n                            Start exploring\n                        </a>\n                        <a class=\"inline-flex min-h-12 items-center justify-center rounded-full border border-white/55 bg-white/10 px-6 text-sm font-semibold text-white backdrop-blur-sm hover:bg-white/20\" data-kid=\"1-2-1-4-1-4-2\" data-name=\"see our promise button\" href=\"#promise\">\n                            See our promise\n                            <span aria-hidden=\"true\" class=\"ml-2\" data-kid=\"1-2-1-4-1-4-2-1\" data-name=\"right arrow icon\">\n                                →\n                            </span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"promise-title\" class=\"mx-auto max-w-[1000px] px-5 py-24 text-center sm:px-8 sm:py-32\" data-kid=\"1-2-2\" data-name=\"promise section\" id=\"promise\">\n            <p class=\"text-sm font-bold uppercase tracking-[.16em] text-[var(--ochre)]\" data-kid=\"1-2-2-1\" data-name=\"promise section label\">\n                Curation, with a point of view\n            </p>\n            <h2 class=\"cozia-story-display mx-auto mt-5 max-w-[850px] text-4xl leading-[1.02] tracking-[-.04em] sm:text-6xl\" data-kid=\"1-2-2-2\" data-name=\"promise section headline\" id=\"promise-title\">\n                Good watching is not about more. It is about finding the right thing for right now.\n            </h2>\n            <div class=\"mt-12 grid gap-5 border-y border-[var(--line)] py-5 text-left sm:grid-cols-3 sm:gap-0\" data-kid=\"1-2-2-3\" data-name=\"promise points grid\">\n                <p class=\"px-0 text-sm leading-6 text-[var(--muted)] sm:px-6 sm:first:pl-0\" data-kid=\"1-2-2-3-1\" data-name=\"thoughtful by default point\">\n                    <span class=\"font-bold text-[var(--ink)]\" data-kid=\"1-2-2-3-1-1\" data-name=\"thoughtful point title\">\n                        Thoughtful by default.\n                    </span>\n                    <br data-kid=\"1-2-2-3-1-2\" data-name=\"line break\"/>\n                    A smaller shelf, chosen with care.\n                </p>\n                <p class=\"border-t border-[var(--line)] px-0 pt-5 text-sm leading-6 text-[var(--muted)] sm:border-l sm:border-t-0 sm:px-6 sm:pt-0\" data-kid=\"1-2-2-3-2\" data-name=\"safe for the room point\">\n                    <span class=\"font-bold text-[var(--ink)]\" data-kid=\"1-2-2-3-2-1\" data-name=\"safe point title\">\n                        Safe for the room.\n                    </span>\n                    <br data-kid=\"1-2-2-3-2-2\" data-name=\"line break\"/>\n                    Family-friendly picks without the guesswork.\n                </p>\n                <p class=\"border-t border-[var(--line)] px-0 pt-5 text-sm leading-6 text-[var(--muted)] sm:border-l sm:border-t-0 sm:px-6 sm:pt-0\" data-kid=\"1-2-2-3-3\" data-name=\"made to be shared point\">\n                    <span class=\"font-bold text-[var(--ink)]\" data-kid=\"1-2-2-3-3-1\" data-name=\"shared point title\">\n                        Made to be shared.\n                    </span>\n                    <br data-kid=\"1-2-2-3-3-2\" data-name=\"line break\"/>\n                    Stories that leave space for conversation.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"story-title\" class=\"mx-auto max-w-[1160px] px-5 pb-24 sm:px-8 sm:pb-32 lg:px-10\" data-kid=\"1-2-3\" data-name=\"families feature section\" id=\"families\">\n            <h2 class=\"sr-only\" data-kid=\"1-2-3-1\" data-name=\"feature section sr-only title\" id=\"story-title\">\n                A better way to choose what to watch\n            </h2>\n            <div class=\"grid items-center gap-10 border-t border-[var(--line)] py-14 lg:grid-cols-[1.1fr_.9fr] lg:gap-20 lg:py-20\" data-kid=\"1-2-3-2\" data-name=\"feature item container 01\">\n                <div class=\"relative order-1 overflow-hidden rounded-[20px] bg-[var(--paper-soft)] lg:order-1\" data-kid=\"1-2-3-2-1\" data-name=\"feature image wrapper 01\">\n                    <img alt=\"Child conducting a science experiment at home, by Tim Mossholder on Unsplash\" class=\"aspect-[4/3] h-full w-full object-cover\" data-kid=\"1-2-3-2-1-1\" data-name=\"feature image 01\" decoding=\"async\" loading=\"lazy\" onerror=\"this.style.display='none'\" src=\"https://images.unsplash.com/photo-1648420325597-d1c217004985?auto=format&w=1200&q=80&fit=crop\"/>\n                </div>\n                <div class=\"order-2 lg:order-2\" data-kid=\"1-2-3-2-2\" data-name=\"feature copy block 01\">\n                    <p class=\"text-sm font-bold tracking-[.12em] text-[var(--ochre)]\" data-kid=\"1-2-3-2-2-1\" data-name=\"feature label 01\">\n                        01\n                        <span class=\"ml-2 font-medium tracking-normal text-[var(--faint)]\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"feature sublabel 01\">\n                            Start with curiosity\n                        </span>\n                    </p>\n                    <h3 class=\"cozia-story-display mt-5 text-4xl leading-[1.02] tracking-[-.04em] sm:text-5xl\" data-kid=\"1-2-3-2-2-2\" data-name=\"feature headline 01\">\n                        Curiosity starts small.\n                    </h3>\n                    <p class=\"mt-5 max-w-[430px] text-base leading-7 text-[var(--muted)]\" data-kid=\"1-2-3-2-2-3\" data-name=\"feature description 01\">\n                        The best discoveries can begin with a glass of water, an unexpected question, or the urge to see what happens next.\n                    </p>\n                    <a class=\"mt-7 inline-flex min-h-11 items-center rounded-lg px-1 py-2 text-sm font-bold text-[var(--sage)] hover:text-[var(--ink)]\" data-kid=\"1-2-3-2-2-4\" data-name=\"feature action link 01\" href=\"#start\">\n                        Explore curious picks\n                        <span aria-hidden=\"true\" class=\"ml-2\" data-kid=\"1-2-3-2-2-4-1\" data-name=\"right arrow icon\">\n                            →\n                        </span>\n                    </a>\n                </div>\n            </div>\n            <div class=\"grid items-center gap-10 border-t border-[var(--line)] py-14 lg:grid-cols-[.9fr_1.1fr] lg:gap-20 lg:py-20\" data-kid=\"1-2-3-3\" data-name=\"feature item container 02\">\n                <div class=\"order-2 lg:order-1\" data-kid=\"1-2-3-3-1\" data-name=\"feature copy block 02\">\n                    <p class=\"text-sm font-bold tracking-[.12em] text-[var(--sage)]\" data-kid=\"1-2-3-3-1-1\" data-name=\"feature label 02\">\n                        02\n                        <span class=\"ml-2 font-medium tracking-normal text-[var(--faint)]\" data-kid=\"1-2-3-3-1-1-1\" data-name=\"feature sublabel 02\">\n                            Make space for together\n                        </span>\n                    </p>\n                    <h3 class=\"cozia-story-display mt-5 text-4xl leading-[1.02] tracking-[-.04em] sm:text-5xl\" data-kid=\"1-2-3-3-1-2\" data-name=\"feature headline 02\">\n                        Make the evening yours.\n                    </h3>\n                    <p class=\"mt-5 max-w-[430px] text-base leading-7 text-[var(--muted)]\" data-kid=\"1-2-3-3-1-3\" data-name=\"feature description 02\">\n                        From a five-minute laugh to a long-form story, Cozia helps everyone find a pace that feels good in the same room.\n                    </p>\n                    <a class=\"mt-7 inline-flex min-h-11 items-center rounded-lg px-1 py-2 text-sm font-bold text-[var(--sage)] hover:text-[var(--ink)]\" data-kid=\"1-2-3-3-1-4\" data-name=\"feature action link 02\" href=\"#start\">\n                        Find your next shared watch\n                        <span aria-hidden=\"true\" class=\"ml-2\" data-kid=\"1-2-3-3-1-4-1\" data-name=\"right arrow icon\">\n                            →\n                        </span>\n                    </a>\n                </div>\n                <div class=\"relative order-1 overflow-hidden rounded-[20px] bg-[var(--paper-soft)] lg:order-2\" data-kid=\"1-2-3-3-2\" data-name=\"feature image wrapper 02\">\n                    <img alt=\"Family watching a video together, by Vitaly Gariev on Unsplash\" class=\"aspect-[4/3] h-full w-full object-cover\" data-kid=\"1-2-3-3-2-1\" data-name=\"feature image 02\" decoding=\"async\" loading=\"lazy\" onerror=\"this.style.display='none'\" src=\"https://images.unsplash.com/photo-1758687125679-d000e186e09b?auto=format&w=1200&q=80&fit=crop\"/>\n                </div>\n            </div>\n            <div class=\"grid items-center gap-10 border-t border-[var(--line)] py-14 lg:grid-cols-[1.1fr_.9fr] lg:gap-20 lg:py-20\" data-kid=\"1-2-3-4\" data-name=\"feature item container 03\">\n                <div class=\"relative order-1 overflow-hidden rounded-[20px] bg-[var(--paper-soft)] lg:order-1\" data-kid=\"1-2-3-4-1\" data-name=\"feature image wrapper 03\">\n                    <img alt=\"Parent and child reading together outdoors, by Austin on Unsplash\" class=\"aspect-[4/3] h-full w-full object-cover\" data-kid=\"1-2-3-4-1-1\" data-name=\"feature image 03\" decoding=\"async\" loading=\"lazy\" onerror=\"this.style.display='none'\" src=\"https://images.unsplash.com/photo-1742093651514-df86c7742aa6?auto=format&w=1200&q=80&fit=crop\"/>\n                </div>\n                <div class=\"order-2 lg:order-2\" data-kid=\"1-2-3-4-2\" data-name=\"feature copy block 03\">\n                    <p class=\"text-sm font-bold tracking-[.12em] text-[var(--ochre)]\" data-kid=\"1-2-3-4-2-1\" data-name=\"feature label 03\">\n                        03\n                        <span class=\"ml-2 font-medium tracking-normal text-[var(--faint)]\" data-kid=\"1-2-3-4-2-1-1\" data-name=\"feature sublabel 03\">\n                            Leave room for more\n                        </span>\n                    </p>\n                    <h3 class=\"cozia-story-display mt-5 text-4xl leading-[1.02] tracking-[-.04em] sm:text-5xl\" data-kid=\"1-2-3-4-2-2\" data-name=\"feature headline 03\">\n                        Keep the conversation going.\n                    </h3>\n                    <p class=\"mt-5 max-w-[430px] text-base leading-7 text-[var(--muted)]\" data-kid=\"1-2-3-4-2-3\" data-name=\"feature description 03\">\n                        A good watch does not end when the credits roll. It gives you one more thing to ask, notice, or carry into tomorrow.\n                    </p>\n                    <a class=\"mt-7 inline-flex min-h-11 items-center rounded-lg px-1 py-2 text-sm font-bold text-[var(--sage)] hover:text-[var(--ink)]\" data-kid=\"1-2-3-4-2-4\" data-name=\"feature action link 03\" href=\"#start\">\n                        See what families are saving\n                        <span aria-hidden=\"true\" class=\"ml-2\" data-kid=\"1-2-3-4-2-4-1\" data-name=\"right arrow icon\">\n                            →\n                        </span>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"shelf-title\" class=\"bg-[var(--paper-soft)] px-5 py-24 sm:px-8 sm:py-32\" data-kid=\"1-2-4\" data-name=\"shelf feature section\" id=\"start\">\n            <div class=\"mx-auto grid max-w-[1160px] items-center gap-12 lg:grid-cols-[.85fr_1.15fr] lg:gap-20\" data-kid=\"1-2-4-1\" data-name=\"shelf section layout\">\n                <div data-kid=\"1-2-4-1-1\" data-name=\"shelf copy block\">\n                    <p class=\"text-sm font-bold uppercase tracking-[.16em] text-[var(--ochre)]\" data-kid=\"1-2-4-1-1-1\" data-name=\"shelf label\">\n                        A shelf that remembers\n                    </p>\n                    <h2 class=\"cozia-story-display mt-5 text-4xl leading-[1.02] tracking-[-.04em] sm:text-5xl\" data-kid=\"1-2-4-1-1-2\" data-name=\"shelf headline\" id=\"shelf-title\">\n                        Your shelf, your rhythm.\n                    </h2>\n                    <p class=\"mt-5 max-w-[410px] text-base leading-7 text-[var(--muted)]\" data-kid=\"1-2-4-1-1-3\" data-name=\"shelf description\">\n                        Save the things that catch your eye. Come back when the room is ready. Share a good find with someone who will love it too.\n                    </p>\n                    <a class=\"mt-7 inline-flex min-h-12 items-center justify-center rounded-full bg-[var(--ink)] px-6 text-sm font-bold text-white hover:bg-[#423d39]\" data-kid=\"1-2-4-1-1-4\" data-name=\"build shelf button\" href=\"#join\">\n                        Build your shelf\n                    </a>\n                </div>\n                <div class=\"rounded-[20px] bg-white p-4 shadow-[0_12px_36px_rgba(44,42,40,.06)] sm:p-6\" data-kid=\"1-2-4-1-2\" data-name=\"shelf demo card container\">\n                    <div class=\"flex items-center justify-between border-b border-[var(--line)] pb-4\" data-kid=\"1-2-4-1-2-1\" data-name=\"shelf card header\">\n                        <div data-kid=\"1-2-4-1-2-1-1\" data-name=\"shelf card title group\">\n                            <p class=\"text-xs font-bold uppercase tracking-[.14em] text-[var(--faint)]\" data-kid=\"1-2-4-1-2-1-1-1\" data-name=\"shelf label small\">\n                                My shelf\n                            </p>\n                            <p class=\"cozia-story-display mt-1 text-2xl\" data-kid=\"1-2-4-1-2-1-1-2\" data-name=\"shelf card title\">\n                                For later\n                            </p>\n                        </div>\n                        <span class=\"rounded-full bg-[var(--sage-soft)] px-3 py-1.5 text-xs font-bold text-[var(--sage)]\" data-kid=\"1-2-4-1-2-1-2\" data-name=\"shelf count badge\">\n                            3 saved\n                        </span>\n                    </div>\n                    <div class=\"mt-5 grid grid-cols-3 gap-3 sm:gap-4\" data-kid=\"1-2-4-1-2-2\" data-name=\"saved items grid\">\n                        <div class=\"overflow-hidden rounded-[14px] bg-[var(--paper-soft)]\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"saved item 01\">\n                            <img alt=\"Child exploring a hands-on project, by Tim Mossholder on Unsplash\" class=\"aspect-[4/5] h-full w-full object-cover\" data-kid=\"1-2-4-1-2-2-1-1\" data-name=\"saved item image 01\" decoding=\"async\" loading=\"lazy\" onerror=\"this.style.display='none'\" src=\"https://images.unsplash.com/photo-1648420325602-0476ebe076d9?auto=format&w=640&q=80&fit=crop\"/>\n                            <div class=\"p-3\" data-kid=\"1-2-4-1-2-2-1-2\" data-name=\"saved item details 01\">\n                                <p class=\"cozia-story-display text-base leading-tight\" data-kid=\"1-2-4-1-2-2-1-2-1\" data-name=\"saved item title 01\">\n                                    Small questions\n                                </p>\n                                <p class=\"mt-1 text-xs text-[var(--muted)]\" data-kid=\"1-2-4-1-2-2-1-2-2\" data-name=\"saved item duration 01\">\n                                    4 min\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"overflow-hidden rounded-[14px] bg-[var(--paper-soft)]\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"saved item 02\">\n                            <img alt=\"Parent and child sharing a quiet moment, by Vitaly Gariev on Unsplash\" class=\"aspect-[4/5] h-full w-full object-cover\" data-kid=\"1-2-4-1-2-2-2-1\" data-name=\"saved item image 02\" decoding=\"async\" loading=\"lazy\" onerror=\"this.style.display='none'\" src=\"https://images.unsplash.com/photo-1758598737761-ca1bc67b5fbf?auto=format&w=640&q=80&fit=crop\"/>\n                            <div class=\"p-3\" data-kid=\"1-2-4-1-2-2-2-2\" data-name=\"saved item details 02\">\n                                <p class=\"cozia-story-display text-base leading-tight\" data-kid=\"1-2-4-1-2-2-2-2-1\" data-name=\"saved item title 02\">\n                                    A little wonder\n                                </p>\n                                <p class=\"mt-1 text-xs text-[var(--muted)]\" data-kid=\"1-2-4-1-2-2-2-2-2\" data-name=\"saved item duration 02\">\n                                    8 min\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"overflow-hidden rounded-[14px] bg-[var(--paper-soft)]\" data-kid=\"1-2-4-1-2-2-3\" data-name=\"saved item 03\">\n                            <img alt=\"Parent and child reading outdoors, by Austin on Unsplash\" class=\"aspect-[4/5] h-full w-full object-cover\" data-kid=\"1-2-4-1-2-2-3-1\" data-name=\"saved item image 03\" decoding=\"async\" loading=\"lazy\" onerror=\"this.style.display='none'\" src=\"https://images.unsplash.com/photo-1742093651514-df86c7742aa6?auto=format&w=640&q=80&fit=crop\"/>\n                            <div class=\"p-3\" data-kid=\"1-2-4-1-2-2-3-2\" data-name=\"saved item details 03\">\n                                <p class=\"cozia-story-display text-base leading-tight\" data-kid=\"1-2-4-1-2-2-3-2-1\" data-name=\"saved item title 03\">\n                                    Keep reading\n                                </p>\n                                <p class=\"mt-1 text-xs text-[var(--muted)]\" data-kid=\"1-2-4-1-2-2-3-2-2\" data-name=\"saved item duration 03\">\n                                    12 min\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"quote-title\" class=\"mx-auto max-w-[1160px] px-5 py-24 sm:px-8 sm:py-32 lg:px-10\" data-kid=\"1-2-5\" data-name=\"testimonial section\">\n            <div class=\"rounded-[22px] bg-[var(--sage-soft)] px-6 py-12 sm:px-12 sm:py-16 lg:px-20\" data-kid=\"1-2-5-1\" data-name=\"testimonial card\">\n                <p class=\"text-sm font-bold uppercase tracking-[.16em] text-[var(--sage)]\" data-kid=\"1-2-5-1-1\" data-name=\"testimonial label\">\n                    What a good choice makes possible\n                </p>\n                <blockquote class=\"cozia-story-display mt-6 max-w-[880px] text-4xl leading-[1.04] tracking-[-.04em] sm:text-6xl\" data-kid=\"1-2-5-1-2\" data-name=\"testimonial quote\" id=\"quote-title\">\n                    “We spend less time deciding and more time being together.”\n                </blockquote>\n                <p class=\"mt-7 text-sm font-semibold text-[var(--muted)]\" data-kid=\"1-2-5-1-3\" data-name=\"testimonial attribution\">\n                    — The Morgan family, Cozia members since 2024\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"closing-title\" class=\"px-5 pb-24 sm:px-8 sm:pb-32 lg:px-10\" data-kid=\"1-2-6\" data-name=\"closing cta section\" id=\"join\">\n            <div class=\"mx-auto max-w-[900px] text-center\" data-kid=\"1-2-6-1\" data-name=\"closing cta content\">\n                <p class=\"text-sm font-bold uppercase tracking-[.16em] text-[var(--ochre)]\" data-kid=\"1-2-6-1-1\" data-name=\"closing cta label\">\n                    Start with something good\n                </p>\n                <h2 class=\"cozia-story-display mt-5 text-5xl leading-[.98] tracking-[-.05em] sm:text-7xl\" data-kid=\"1-2-6-1-2\" data-name=\"closing cta headline\" id=\"closing-title\">\n                    Good watching begins with a good choice.\n                </h2>\n                <p class=\"mx-auto mt-6 max-w-[480px] text-base leading-7 text-[var(--muted)]\" data-kid=\"1-2-6-1-3\" data-name=\"closing cta description\">\n                    Join a calmer way to find family-safe video, one thoughtful pick at a time.\n                </p>\n                <a class=\"mt-9 inline-flex min-h-14 w-full items-center justify-center rounded-full bg-[var(--ochre)] px-7 text-base font-bold text-white shadow-[0_8px_20px_rgba(212,140,70,.2)] hover:bg-[#c47b35] sm:w-auto\" data-kid=\"1-2-6-1-4\" data-name=\"closing cta button\" href=\"#top\">\n                    Start exploring Cozia\n                    <span aria-hidden=\"true\" class=\"ml-3\" data-kid=\"1-2-6-1-4-1\" data-name=\"right arrow icon\">\n                        →\n                    </span>\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[var(--line)] px-5 py-8 sm:px-8 lg:px-10\" data-kid=\"1-3\" data-name=\"page footer\">\n        <div class=\"mx-auto flex max-w-[1160px] flex-col gap-5 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-3-1\" data-name=\"footer contents container\">\n            <a class=\"cozia-story-display rounded-lg px-1 py-1 text-xl font-semibold\" data-kid=\"1-3-1-1\" data-name=\"footer logo link\" href=\"#top\">\n                Cozia\n                <span class=\"text-[var(--ochre)]\" data-kid=\"1-3-1-1-1\" data-name=\"footer logo period icon\">\n                    .\n                </span>\n            </a>\n            <nav aria-label=\"Footer navigation\" class=\"flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-[var(--muted)]\" data-kid=\"1-3-1-2\" data-name=\"footer navigation menu\">\n                <a class=\"rounded-lg py-2 hover:text-[var(--ink)]\" data-kid=\"1-3-1-2-1\" data-name=\"privacy link\" href=\"#privacy\">\n                    Privacy\n                </a>\n                <a class=\"rounded-lg py-2 hover:text-[var(--ink)]\" data-kid=\"1-3-1-2-2\" data-name=\"guidelines link\" href=\"#guidelines\">\n                    Guidelines\n                </a>\n                <a class=\"rounded-lg py-2 hover:text-[var(--ink)]\" data-kid=\"1-3-1-2-3\" data-name=\"terms link\" href=\"#terms\">\n                    Terms\n                </a>\n            </nav>\n        </div>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-08-07T15:50:23.163728+00:00",
      "modified": "2026-08-07T15:50:53.488589+00:00",
      "id": "var_8ca3d62241b2"
    },
    "var_b55fbd39d9f0": {
      "type": "variant",
      "label": "Cozia Journal — Landing Page / Family Guide",
      "parentId": "var_8bde86490f7a",
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap');\n  :root {\n    --paper: #FDFBF7;\n    --paper-soft: #F6F1EA;\n    --card: #FFFFFF;\n    --ink: #2C2A28;\n    --muted: #5E5955;\n    --faint: #6C6259;\n    --ochre: #D48C46;\n    --ochre-soft: #F3E3D1;\n    --sage: #4A7C73;\n    --sage-soft: #E3EFEB;\n    --line: #E9E2DA;\n  }\n  .cozia-landing { font-family: 'Manrope', sans-serif; background: var(--paper); color: var(--ink); }\n  .cozia-landing .display { font-family: 'Fraunces', serif; }\n  .cozia-landing .focus-ring:focus-visible { outline: 2px solid var(--sage); outline-offset: 4px; }\n  .cozia-landing .focus-ochre:focus-visible { outline: 2px solid var(--ochre); outline-offset: 4px; }\n  .cozia-landing a, .cozia-landing button { min-height: 44px; }\n  .cozia-landing img { display: block; }\n  .cozia-landing img[onerror] { color: transparent; font-size: 0; }\n  @media (max-width: 767px) {\n    .cozia-landing .desktop-links { display: none; }\n    .cozia-landing .mobile-menu { display: inline-flex; }\n    .cozia-landing .hero-title { font-size: clamp(3rem, 13vw, 4.5rem); }\n    .cozia-landing .scrapbook-panel:first-child { margin-left: 0; }\n  }\n  @media (min-width: 768px) {\n    .cozia-landing .mobile-menu { display: none; }\n  }\n</style>\n<div class=\"cozia-landing min-h-screen\" data-kid=\"1\" data-name=\"Cozia family guide landing page\">\n    <header class=\"border-b border-[var(--line)] bg-[rgba(253,251,247,.96)]\" data-kid=\"1-1\" data-name=\"compact marketing header\">\n        <div class=\"mx-auto flex min-h-[76px] max-w-[1200px] items-center gap-6 px-5 sm:px-8 lg:px-10\" data-kid=\"1-1-1\" data-name=\"header container\">\n            <a aria-label=\"Cozia home\" class=\"focus-ring display flex min-h-11 items-center rounded-lg px-1 text-[28px] font-semibold tracking-[-.05em]\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#top\">\n                Cozia\n                <span class=\"text-[var(--ochre)]\" data-kid=\"1-1-1-1-1\" data-name=\"logo accent dot\">\n                    .\n                </span>\n            </a>\n            <nav aria-label=\"Landing page navigation\" class=\"desktop-links flex items-center gap-1\" data-kid=\"1-1-1-2\" data-name=\"desktop navigation links\">\n                <a class=\"focus-ring rounded-lg px-3 py-2 text-sm font-semibold text-[var(--ink)]\" data-kid=\"1-1-1-2-1\" data-name=\"our approach navigation link\" href=\"#approach\">\n                    Our approach\n                </a>\n                <a class=\"focus-ring rounded-lg px-3 py-2 text-sm font-medium text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-2\" data-name=\"families navigation link\" href=\"#families\">\n                    Families\n                </a>\n                <a class=\"focus-ring rounded-lg px-3 py-2 text-sm font-medium text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-3\" data-name=\"safety navigation link\" href=\"#safety\">\n                    Safety\n                </a>\n            </nav>\n            <div class=\"ml-auto flex items-center gap-3\" data-kid=\"1-1-1-3\" data-name=\"header utility actions container\">\n                <a class=\"desktop-links focus-ring rounded-lg px-3 py-2 text-sm font-semibold text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-3-1\" data-name=\"sign in navigation link\" href=\"#signin\">\n                    Sign in\n                </a>\n                <a class=\"focus-ochre inline-flex min-h-11 items-center justify-center rounded-full bg-[var(--ochre)] px-5 text-sm font-bold text-white shadow-[0_7px_18px_rgba(212,140,70,.2)] hover:bg-[#BD7537]\" data-kid=\"1-1-1-3-2\" data-name=\"explore cozia primary call-to-action button\" href=\"#explore\">\n                    Explore Cozia\n                </a>\n                <button aria-label=\"Open menu\" class=\"mobile-menu focus-ring hidden min-h-11 min-w-11 items-center justify-center rounded-full border border-[var(--line)] bg-white text-xl text-[var(--ink)]\" data-kid=\"1-1-1-3-3\" data-name=\"mobile menu toggle button\" type=\"button\">\n                    ☰\n                </button>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\" id=\"top\">\n        <section aria-labelledby=\"landing-hero-title\" class=\"mx-auto max-w-[1200px] px-5 pb-20 pt-12 sm:px-8 sm:pb-28 sm:pt-20 lg:px-10\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"grid items-center gap-12 lg:grid-cols-[.92fr_1.08fr] lg:gap-20\" data-kid=\"1-2-1-1\" data-name=\"hero layout grid\">\n                <div class=\"max-w-[570px]\" data-kid=\"1-2-1-1-1\" data-name=\"hero text content block\">\n                    <p class=\"mb-5 text-sm font-bold uppercase tracking-[.16em] text-[var(--ochre)]\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero pre-headline label\">\n                        A calmer way to watch\n                    </p>\n                    <h1 class=\"display hero-title text-[clamp(3.4rem,6.2vw,6.25rem)] leading-[.94] tracking-[-.055em]\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero headline text\" id=\"landing-hero-title\">\n                        What if screen time felt like together time?\n                    </h1>\n                    <p class=\"mt-7 max-w-[500px] text-[17px] leading-8 text-[var(--muted)]\" data-kid=\"1-2-1-1-1-3\" data-name=\"hero description text\">\n                        Cozia brings thoughtful, family-friendly videos into one gentle place—so finding something good becomes part of the evening, not another thing to manage.\n                    </p>\n                    <div class=\"mt-9 flex flex-col gap-3 sm:flex-row\" data-kid=\"1-2-1-1-1-4\" data-name=\"hero call-to-action buttons container\">\n                        <a class=\"focus-ochre inline-flex min-h-12 items-center justify-center rounded-full bg-[var(--ink)] px-6 text-sm font-bold text-white hover:bg-[#413B36]\" data-kid=\"1-2-1-1-1-4-1\" data-name=\"start exploring button\" href=\"#explore\">\n                            Start exploring\n                            <span aria-hidden=\"true\" class=\"ml-2 text-lg\" data-kid=\"1-2-1-1-1-4-1-1\" data-name=\"right arrow icon\">\n                                →\n                            </span>\n                        </a>\n                        <a class=\"focus-ring inline-flex min-h-12 items-center justify-center rounded-full border border-[var(--line)] bg-white px-6 text-sm font-semibold text-[var(--ink)] hover:border-[var(--ochre)]\" data-kid=\"1-2-1-1-1-4-2\" data-name=\"see how it works button\" href=\"#approach\">\n                            See how it works\n                        </a>\n                    </div>\n                </div>\n                <div aria-label=\"Family viewing moments\" class=\"relative min-h-[470px] sm:min-h-[560px]\" data-kid=\"1-2-1-1-2\" data-name=\"hero visual gallery container\">\n                    <div class=\"scrapbook-panel absolute right-0 top-2 w-[84%] rotate-[2deg] overflow-hidden rounded-[22px] bg-white p-3 shadow-[0_18px_45px_rgba(44,42,40,.12)] sm:w-[78%]\" data-kid=\"1-2-1-1-2-1\" data-name=\"scrapbook panel top\">\n                        <div class=\"relative aspect-[4/3] overflow-hidden rounded-[15px] bg-[var(--paper-soft)]\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"scrapbook image container\">\n                            <img alt=\"Family watching a movie together on a cozy couch, by Vitaly Gariev on Unsplash\" class=\"h-full w-full object-cover\" data-kid=\"1-2-1-1-2-1-1-1\" data-name=\"family viewing photograph\" decoding=\"async\" loading=\"lazy\" onerror=\"this.style.display='none'\" src=\"https://images.unsplash.com/photo-1758687125866-6b9d86d41cc5?auto=format&w=960&q=80&fit=crop\"/>\n                            <div class=\"absolute bottom-4 left-4 rounded-full bg-white/95 px-4 py-2 text-sm font-bold text-[var(--ink)]\" data-kid=\"1-2-1-1-2-1-1-2\" data-name=\"scrapbook image label\">\n                                For shared evenings\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"scrapbook-panel absolute bottom-2 left-0 w-[69%] -rotate-[5deg] overflow-hidden rounded-[22px] bg-white p-3 shadow-[0_18px_45px_rgba(44,42,40,.14)] sm:w-[62%]\" data-kid=\"1-2-1-1-2-2\" data-name=\"scrapbook panel bottom\">\n                        <div class=\"relative aspect-[4/3] overflow-hidden rounded-[15px] bg-[var(--paper-soft)]\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"scrapbook image container\">\n                            <img alt=\"Child conducting a science experiment at home, by Tim Mossholder on Unsplash\" class=\"h-full w-full object-cover\" data-kid=\"1-2-1-1-2-2-1-1\" data-name=\"child experiment photograph\" decoding=\"async\" loading=\"lazy\" onerror=\"this.style.display='none'\" src=\"https://images.unsplash.com/photo-1648420325597-d1c217004985?auto=format&w=800&q=80&fit=crop\"/>\n                            <div class=\"absolute bottom-4 left-4 rounded-full bg-[var(--sage-soft)] px-4 py-2 text-sm font-bold text-[var(--sage)]\" data-kid=\"1-2-1-1-2-2-1-2\" data-name=\"scrapbook image label\">\n                                For curious minds\n                            </div>\n                        </div>\n                    </div>\n                    <span class=\"absolute left-[3%] top-[28%] h-3 w-3 rounded-full bg-[var(--ochre)] sm:left-[6%]\" data-kid=\"1-2-1-1-2-3\" data-name=\"decorative ochre dot\">\n                    </span>\n                    <span class=\"absolute right-[4%] bottom-[23%] h-4 w-4 rounded-full border-2 border-[var(--sage)] sm:right-[8%]\" data-kid=\"1-2-1-1-2-4\" data-name=\"decorative sage ring\">\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"manifesto-title\" class=\"border-y border-[var(--line)] bg-[var(--paper-soft)]\" data-kid=\"1-2-2\" data-name=\"manifesto section\" id=\"approach\">\n            <div class=\"mx-auto grid max-w-[1200px] gap-6 px-5 py-10 sm:px-8 sm:py-14 lg:grid-cols-[.9fr_1.1fr] lg:items-center lg:px-10\" data-kid=\"1-2-2-1\" data-name=\"manifesto section layout\">\n                <h2 class=\"display text-4xl leading-tight tracking-[-.04em] sm:text-5xl\" data-kid=\"1-2-2-1-1\" data-name=\"manifesto headline\" id=\"manifesto-title\">\n                    Less noise.\n                    <br data-kid=\"1-2-2-1-1-1\" data-name=\"line break\"/>\n                    <span class=\"text-[var(--ochre)]\" data-kid=\"1-2-2-1-1-2\" data-name=\"manifesto headline accent text\">\n                        More good stories.\n                    </span>\n                </h2>\n                <p class=\"max-w-[560px] text-[17px] leading-8 text-[var(--muted)]\" data-kid=\"1-2-2-1-2\" data-name=\"manifesto description\">\n                    We believe a family video library should feel more like a thoughtful recommendation from someone you trust—and less like an endless feed asking for attention.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"return-title\" class=\"mx-auto max-w-[1200px] px-5 py-20 sm:px-8 sm:py-28 lg:px-10\" data-kid=\"1-2-3\" data-name=\"families return section\" id=\"families\">\n            <div class=\"mb-10 max-w-[630px]\" data-kid=\"1-2-3-1\" data-name=\"section header container\">\n                <p class=\"mb-4 text-sm font-bold uppercase tracking-[.16em] text-[var(--sage)]\" data-kid=\"1-2-3-1-1\" data-name=\"section pre-headline\">\n                    Made for the whole household\n                </p>\n                <h2 class=\"display text-4xl leading-tight tracking-[-.04em] sm:text-5xl\" data-kid=\"1-2-3-1-2\" data-name=\"section headline\" id=\"return-title\">\n                    Why families return\n                </h2>\n                <p class=\"mt-5 text-[17px] leading-8 text-[var(--muted)]\" data-kid=\"1-2-3-1-3\" data-name=\"section description\">\n                    A few simple decisions make it easier to find the right thing, at the right moment.\n                </p>\n            </div>\n            <div class=\"grid border-t border-[var(--line)] sm:grid-cols-2\" data-kid=\"1-2-3-2\" data-name=\"feature grid\">\n                <article class=\"border-b border-[var(--line)] py-8 pr-7 sm:border-r sm:pr-10\" data-kid=\"1-2-3-2-1\" data-name=\"feature card 01\">\n                    <div class=\"mb-6 flex items-center justify-between\" data-kid=\"1-2-3-2-1-1\" data-name=\"feature number and accent container\">\n                        <span class=\"text-sm font-bold text-[var(--ochre)]\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"feature label number\">\n                            01\n                        </span>\n                        <span class=\"h-1 w-16 rounded-full bg-[var(--ochre)]\" data-kid=\"1-2-3-2-1-1-2\" data-name=\"feature accent bar\">\n                        </span>\n                    </div>\n                    <h3 class=\"display text-2xl tracking-[-.025em]\" data-kid=\"1-2-3-2-1-2\" data-name=\"feature title\">\n                        Human-reviewed curation\n                    </h3>\n                    <p class=\"mt-3 text-[15px] leading-7 text-[var(--muted)]\" data-kid=\"1-2-3-2-1-3\" data-name=\"feature description\">\n                        Every pick is considered for tone, usefulness, and family context before it earns a place on your shelf.\n                    </p>\n                </article>\n                <article class=\"border-b border-[var(--line)] py-8 sm:pl-10\" data-kid=\"1-2-3-2-2\" data-name=\"feature card 02\">\n                    <div class=\"mb-6 flex items-center justify-between\" data-kid=\"1-2-3-2-2-1\" data-name=\"feature number and accent container\">\n                        <span class=\"text-sm font-bold text-[var(--sage)]\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"feature label number\">\n                            02\n                        </span>\n                        <span class=\"h-1 w-16 rounded-full bg-[var(--sage)]\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"feature accent bar\">\n                        </span>\n                    </div>\n                    <h3 class=\"display text-2xl tracking-[-.025em]\" data-kid=\"1-2-3-2-2-2\" data-name=\"feature title\">\n                        One place for many platforms\n                    </h3>\n                    <p class=\"mt-3 text-[15px] leading-7 text-[var(--muted)]\" data-kid=\"1-2-3-2-2-3\" data-name=\"feature description\">\n                        Find the best from YouTube, Vimeo, Dailymotion, and Twitch without opening four different rabbit holes.\n                    </p>\n                </article>\n                <article class=\"border-b border-[var(--line)] py-8 pr-7 sm:border-r sm:pr-10\" data-kid=\"1-2-3-2-3\" data-name=\"feature card 03\">\n                    <div class=\"mb-6 flex items-center justify-between\" data-kid=\"1-2-3-2-3-1\" data-name=\"feature number and accent container\">\n                        <span class=\"text-sm font-bold text-[var(--sage)]\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"feature label number\">\n                            03\n                        </span>\n                        <span class=\"h-1 w-16 rounded-full bg-[var(--sage)]\" data-kid=\"1-2-3-2-3-1-2\" data-name=\"feature accent bar\">\n                        </span>\n                    </div>\n                    <h3 class=\"display text-2xl tracking-[-.025em]\" data-kid=\"1-2-3-2-3-2\" data-name=\"feature title\">\n                        A shelf that remembers\n                    </h3>\n                    <p class=\"mt-3 text-[15px] leading-7 text-[var(--muted)]\" data-kid=\"1-2-3-2-3-3\" data-name=\"feature description\">\n                        Save the discoveries worth returning to, so “what should we watch?” has an easier answer next time.\n                    </p>\n                </article>\n                <article class=\"border-b border-[var(--line)] py-8 sm:pl-10\" data-kid=\"1-2-3-2-4\" data-name=\"feature card 04\">\n                    <div class=\"mb-6 flex items-center justify-between\" data-kid=\"1-2-3-2-4-1\" data-name=\"feature number and accent container\">\n                        <span class=\"text-sm font-bold text-[var(--ochre)]\" data-kid=\"1-2-3-2-4-1-1\" data-name=\"feature label number\">\n                            04\n                        </span>\n                        <span class=\"h-1 w-16 rounded-full bg-[var(--ochre)]\" data-kid=\"1-2-3-2-4-1-2\" data-name=\"feature accent bar\">\n                        </span>\n                    </div>\n                    <h3 class=\"display text-2xl tracking-[-.025em]\" data-kid=\"1-2-3-2-4-2\" data-name=\"feature title\">\n                        Kids Mode when you need it\n                    </h3>\n                    <p class=\"mt-3 text-[15px] leading-7 text-[var(--muted)]\" data-kid=\"1-2-3-2-4-3\" data-name=\"feature description\">\n                        A protected, family-approved view gives younger viewers more independence while keeping grown-ups in control.\n                    </p>\n                </article>\n            </div>\n        </section>\n        <section aria-labelledby=\"moments-title\" class=\"bg-[var(--sage-soft)]\" data-kid=\"1-2-4\" data-name=\"moments section\" id=\"safety\">\n            <div class=\"mx-auto grid max-w-[1200px] items-center gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-[1.05fr_.95fr] lg:px-10\" data-kid=\"1-2-4-1\" data-name=\"moments section layout\">\n                <div class=\"relative overflow-hidden rounded-[22px] bg-[#D5E6DF] p-3 shadow-[0_18px_45px_rgba(44,42,40,.08)]\" data-kid=\"1-2-4-1-1\" data-name=\"moments visual container\">\n                    <div class=\"relative aspect-[4/3] overflow-hidden rounded-[15px] bg-[#C6DDD5]\" data-kid=\"1-2-4-1-1-1\" data-name=\"moments image container\">\n                        <img alt=\"Parent and child reading together outdoors, by Austin on Unsplash\" class=\"h-full w-full object-cover\" data-kid=\"1-2-4-1-1-1-1\" data-name=\"outdoor photo\" decoding=\"async\" loading=\"lazy\" onerror=\"this.style.display='none'\" src=\"https://images.unsplash.com/photo-1742093651514-df86c7742aa6?auto=format&w=1200&q=80&fit=crop\"/>\n                    </div>\n                    <p class=\"display absolute bottom-7 left-7 max-w-[235px] text-3xl leading-none text-white drop-shadow-[0_2px_12px_rgba(0,0,0,.35)]\" data-kid=\"1-2-4-1-1-2\" data-name=\"moments overlay text\">\n                        Good stories meet us where we are.\n                    </p>\n                </div>\n                <div data-kid=\"1-2-4-1-2\" data-name=\"moments text content\">\n                    <p class=\"mb-4 text-sm font-bold uppercase tracking-[.16em] text-[var(--sage)]\" data-kid=\"1-2-4-1-2-1\" data-name=\"moments pre-headline\">\n                        Built for the in-between moments\n                    </p>\n                    <h2 class=\"display text-4xl leading-tight tracking-[-.04em] sm:text-5xl\" data-kid=\"1-2-4-1-2-2\" data-name=\"moments headline\" id=\"moments-title\">\n                        The minutes that become memories.\n                    </h2>\n                    <p class=\"mt-5 text-[17px] leading-8 text-[var(--muted)]\" data-kid=\"1-2-4-1-2-3\" data-name=\"moments description\">\n                        Cozia is there for the small windows of time that matter: when everyone is home, curious, and ready for something gentle.\n                    </p>\n                    <div class=\"mt-8 grid gap-0 border-t border-[rgba(74,124,115,.25)]\" data-kid=\"1-2-4-1-2-4\" data-name=\"moment items grid\">\n                        <div class=\"flex items-center justify-between border-b border-[rgba(74,124,115,.25)] py-4 text-[15px] font-semibold\" data-kid=\"1-2-4-1-2-4-1\" data-name=\"moment item 1\">\n                            <span data-kid=\"1-2-4-1-2-4-1-1\" data-name=\"moment title\">\n                                After school\n                            </span>\n                            <span class=\"text-[var(--sage)]\" data-kid=\"1-2-4-1-2-4-1-2\" data-name=\"moment highlight text\">\n                                A reset, not a scroll\n                            </span>\n                        </div>\n                        <div class=\"flex items-center justify-between border-b border-[rgba(74,124,115,.25)] py-4 text-[15px] font-semibold\" data-kid=\"1-2-4-1-2-4-2\" data-name=\"moment item 2\">\n                            <span data-kid=\"1-2-4-1-2-4-2-1\" data-name=\"moment title\">\n                                Weekend mornings\n                            </span>\n                            <span class=\"text-[var(--sage)]\" data-kid=\"1-2-4-1-2-4-2-2\" data-name=\"moment highlight text\">\n                                A question to follow\n                            </span>\n                        </div>\n                        <div class=\"flex items-center justify-between border-b border-[rgba(74,124,115,.25)] py-4 text-[15px] font-semibold\" data-kid=\"1-2-4-1-2-4-3\" data-name=\"moment item 3\">\n                            <span data-kid=\"1-2-4-1-2-4-3-1\" data-name=\"moment title\">\n                                Before bed\n                            </span>\n                            <span class=\"text-[var(--sage)]\" data-kid=\"1-2-4-1-2-4-3-2\" data-name=\"moment highlight text\">\n                                A story to share\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"rhythm-title\" class=\"mx-auto max-w-[1200px] px-5 py-20 sm:px-8 sm:py-28 lg:px-10\" data-kid=\"1-2-5\" data-name=\"rhythm section\">\n            <div class=\"grid gap-12 lg:grid-cols-[.85fr_1.15fr] lg:gap-24\" data-kid=\"1-2-5-1\" data-name=\"rhythm section layout\">\n                <div data-kid=\"1-2-5-1-1\" data-name=\"rhythm text content\">\n                    <p class=\"mb-4 text-sm font-bold uppercase tracking-[.16em] text-[var(--ochre)]\" data-kid=\"1-2-5-1-1-1\" data-name=\"rhythm pre-headline\">\n                        No complicated setup\n                    </p>\n                    <h2 class=\"display text-4xl leading-tight tracking-[-.04em] sm:text-5xl\" data-kid=\"1-2-5-1-1-2\" data-name=\"rhythm headline\" id=\"rhythm-title\">\n                        A simple rhythm\n                    </h2>\n                    <p class=\"mt-5 max-w-[430px] text-[17px] leading-8 text-[var(--muted)]\" data-kid=\"1-2-5-1-1-3\" data-name=\"rhythm description\">\n                        From the first idea to the last “one more,” Cozia keeps the good part close.\n                    </p>\n                    <a class=\"focus-ochre mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-[var(--ink)] px-6 text-sm font-bold text-white hover:bg-[#413B36]\" data-kid=\"1-2-5-1-1-4\" data-name=\"rhythm primary call-to-action button\" href=\"#explore\">\n                        Find your next watch\n                        <span aria-hidden=\"true\" class=\"ml-2 text-lg\" data-kid=\"1-2-5-1-1-4-1\" data-name=\"right arrow icon\">\n                            →\n                        </span>\n                    </a>\n                </div>\n                <ol class=\"border-t border-[var(--line)]\" data-kid=\"1-2-5-1-2\" data-name=\"rhythm steps list\">\n                    <li class=\"grid grid-cols-[58px_1fr] gap-5 border-b border-[var(--line)] py-7\" data-kid=\"1-2-5-1-2-1\" data-name=\"step 1\">\n                        <span class=\"display text-3xl text-[var(--ochre)]\" data-kid=\"1-2-5-1-2-1-1\" data-name=\"step number\">\n                            01\n                        </span>\n                        <div data-kid=\"1-2-5-1-2-1-2\" data-name=\"step content container\">\n                            <h3 class=\"display text-2xl\" data-kid=\"1-2-5-1-2-1-2-1\" data-name=\"step title\">\n                                Choose\n                            </h3>\n                            <p class=\"mt-2 text-[15px] leading-7 text-[var(--muted)]\" data-kid=\"1-2-5-1-2-1-2-2\" data-name=\"step description\">\n                                Start with a shelf shaped around real family interests—not whatever happens to be loudest today.\n                            </p>\n                        </div>\n                    </li>\n                    <li class=\"grid grid-cols-[58px_1fr] gap-5 border-b border-[var(--line)] py-7\" data-kid=\"1-2-5-1-2-2\" data-name=\"step 2\">\n                        <span class=\"display text-3xl text-[var(--sage)]\" data-kid=\"1-2-5-1-2-2-1\" data-name=\"step number\">\n                            02\n                        </span>\n                        <div data-kid=\"1-2-5-1-2-2-2\" data-name=\"step content container\">\n                            <h3 class=\"display text-2xl\" data-kid=\"1-2-5-1-2-2-2-1\" data-name=\"step title\">\n                                Watch\n                            </h3>\n                            <p class=\"mt-2 text-[15px] leading-7 text-[var(--muted)]\" data-kid=\"1-2-5-1-2-2-2-2\" data-name=\"step description\">\n                                Press play on something thoughtful, with enough room for everyone to lean in.\n                            </p>\n                        </div>\n                    </li>\n                    <li class=\"grid grid-cols-[58px_1fr] gap-5 border-b border-[var(--line)] py-7\" data-kid=\"1-2-5-1-2-3\" data-name=\"step 3\">\n                        <span class=\"display text-3xl text-[var(--ochre)]\" data-kid=\"1-2-5-1-2-3-1\" data-name=\"step number\">\n                            03\n                        </span>\n                        <div data-kid=\"1-2-5-1-2-3-2\" data-name=\"step content container\">\n                            <h3 class=\"display text-2xl\" data-kid=\"1-2-5-1-2-3-2-1\" data-name=\"step title\">\n                                Share\n                            </h3>\n                            <p class=\"mt-2 text-[15px] leading-7 text-[var(--muted)]\" data-kid=\"1-2-5-1-2-3-2-2\" data-name=\"step description\">\n                                Save a favorite, pass along a recommendation, or let the next conversation begin.\n                            </p>\n                        </div>\n                    </li>\n                </ol>\n            </div>\n        </section>\n        <section aria-labelledby=\"trust-title\" class=\"border-y border-[var(--line)] bg-white\" data-kid=\"1-2-6\" data-name=\"trust section\">\n            <div class=\"mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:px-10\" data-kid=\"1-2-6-1\" data-name=\"trust section container\">\n                <h2 class=\"display text-3xl tracking-[-.03em] sm:text-4xl\" data-kid=\"1-2-6-1-1\" data-name=\"trust headline\" id=\"trust-title\">\n                    Good viewing is a family habit.\n                </h2>\n                <div class=\"mt-9 grid gap-7 sm:grid-cols-3\" data-kid=\"1-2-6-1-2\" data-name=\"trust grid\">\n                    <div class=\"border-t-2 border-[var(--ochre)] pt-4\" data-kid=\"1-2-6-1-2-1\" data-name=\"trust card 1\">\n                        <p class=\"text-[15px] font-bold\" data-kid=\"1-2-6-1-2-1-1\" data-name=\"trust point title\">\n                            Thoughtful by default\n                        </p>\n                        <p class=\"mt-2 text-[15px] leading-7 text-[var(--muted)]\" data-kid=\"1-2-6-1-2-1-2\" data-name=\"trust point description\">\n                            A smaller, considered starting point for every screen.\n                        </p>\n                    </div>\n                    <div class=\"border-t-2 border-[var(--sage)] pt-4\" data-kid=\"1-2-6-1-2-2\" data-name=\"trust card 2\">\n                        <p class=\"text-[15px] font-bold\" data-kid=\"1-2-6-1-2-2-1\" data-name=\"trust point title\">\n                            Made for conversation\n                        </p>\n                        <p class=\"mt-2 text-[15px] leading-7 text-[var(--muted)]\" data-kid=\"1-2-6-1-2-2-2\" data-name=\"trust point description\">\n                            Stories that leave a little space for questions and ideas.\n                        </p>\n                    </div>\n                    <div class=\"border-t-2 border-[var(--ochre)] pt-4\" data-kid=\"1-2-6-1-2-3\" data-name=\"trust card 3\">\n                        <p class=\"text-[15px] font-bold\" data-kid=\"1-2-6-1-2-3-1\" data-name=\"trust point title\">\n                            Grown-up peace of mind\n                        </p>\n                        <p class=\"mt-2 text-[15px] leading-7 text-[var(--muted)]\" data-kid=\"1-2-6-1-2-3-2\" data-name=\"trust point description\">\n                            Clear controls and family-safe choices, without the fuss.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-[1200px] px-5 py-20 sm:px-8 sm:py-28 lg:px-10\" data-kid=\"1-2-7\" data-name=\"explore call-to-action section\" id=\"explore\">\n            <div class=\"overflow-hidden rounded-[24px] bg-[var(--ochre)] px-7 py-12 text-white sm:px-12 sm:py-16 lg:flex lg:items-end lg:justify-between lg:gap-12\" data-kid=\"1-2-7-1\" data-name=\"explore container\">\n                <div class=\"max-w-[690px]\" data-kid=\"1-2-7-1-1\" data-name=\"explore text content\">\n                    <p class=\"mb-4 text-sm font-bold uppercase tracking-[.16em] text-[#FFE7C8]\" data-kid=\"1-2-7-1-1-1\" data-name=\"explore pre-headline\">\n                        Your next good thing is close\n                    </p>\n                    <h2 class=\"display text-5xl leading-[.96] tracking-[-.05em] sm:text-6xl\" data-kid=\"1-2-7-1-1-2\" data-name=\"explore headline\">\n                        Keep a little wonder nearby.\n                    </h2>\n                    <p class=\"mt-5 max-w-[560px] text-[17px] leading-8 text-white/90\" data-kid=\"1-2-7-1-1-3\" data-name=\"explore description\">\n                        Make space for stories, questions, and the kind of screen time that brings people a little closer.\n                    </p>\n                </div>\n                <a class=\"focus-ring mt-8 inline-flex min-h-12 shrink-0 items-center justify-center rounded-full bg-white px-7 text-sm font-bold text-[var(--ink)] hover:bg-[#FFF8F0] lg:mt-0\" data-kid=\"1-2-7-1-2\" data-name=\"explore button\" href=\"#top\">\n                    Start exploring\n                    <span aria-hidden=\"true\" class=\"ml-2 text-lg\" data-kid=\"1-2-7-1-2-1\" data-name=\"right arrow icon\">\n                        →\n                    </span>\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[var(--line)] bg-[var(--paper-soft)]\" data-kid=\"1-3\" data-name=\"site footer\">\n        <div class=\"mx-auto flex max-w-[1200px] flex-col gap-5 px-5 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-10\" data-kid=\"1-3-1\" data-name=\"footer contents container\">\n            <a class=\"focus-ring display inline-flex min-h-11 items-center rounded-lg text-xl font-semibold tracking-[-.04em]\" data-kid=\"1-3-1-1\" data-name=\"footer brand link\" href=\"#top\">\n                Cozia\n                <span class=\"text-[var(--ochre)]\" data-kid=\"1-3-1-1-1\" data-name=\"footer logo accent dot\">\n                    .\n                </span>\n            </a>\n            <nav aria-label=\"Legal links\" class=\"flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-[var(--muted)]\" data-kid=\"1-3-1-2\" data-name=\"legal navigation links\">\n                <a class=\"focus-ring rounded-lg py-2 hover:text-[var(--ink)]\" data-kid=\"1-3-1-2-1\" data-name=\"privacy link\" href=\"#privacy\">\n                    Privacy\n                </a>\n                <a class=\"focus-ring rounded-lg py-2 hover:text-[var(--ink)]\" data-kid=\"1-3-1-2-2\" data-name=\"terms link\" href=\"#terms\">\n                    Terms\n                </a>\n                <a class=\"focus-ring rounded-lg py-2 hover:text-[var(--ink)]\" data-kid=\"1-3-1-2-3\" data-name=\"safety link\" href=\"#safety\">\n                    Safety\n                </a>\n            </nav>\n        </div>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-08-07T15:50:28.328643+00:00",
      "modified": "2026-08-07T15:51:25.847714+00:00",
