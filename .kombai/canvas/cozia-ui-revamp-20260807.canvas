    "var_dd50d18c4f38": {
      "type": "variant",
      "label": "Cozia Journal — Landing Page / Editorial",
      "parentId": "var_8bde86490f7a",
      "themeId": null,
      "rect": {
        "x": 4140,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap');\n  :root {\n    --paper: #FDFBF7;\n    --paper-soft: #F6F1EA;\n    --card: #FFFFFF;\n    --ink: #2C2A28;\n    --muted: #5E5955;\n    --faint: #756D65;\n    --ochre: #D48C46;\n    --ochre-soft: #F3E3D1;\n    --sage: #4A7C73;\n    --sage-soft: #E3EFEB;\n    --line: #E9E2DA;\n  }\n  .landing-page { font-family: 'Manrope', sans-serif; background: var(--paper); color: var(--ink); }\n  .landing-display { font-family: 'Fraunces', serif; }\n  .landing-focus:focus-visible { outline: 2px solid var(--sage); outline-offset: 4px; }\n  .landing-focus-ochre:focus-visible { outline: 2px solid var(--ochre); outline-offset: 4px; }\n  .landing-page img { display: block; }\n  .landing-page a, .landing-page button { min-height: 44px; }\n  @media (max-width: 767px) {\n    .hero-gradient { background: linear-gradient(180deg, rgba(44,42,40,.04) 12%, rgba(44,42,40,.88) 76%); }\n  }\n</style>\n<div class=\"landing-page min-h-screen\" data-kid=\"1\" data-name=\"landing page container\">\n    <header class=\"border-b border-[var(--line)] bg-[rgba(253,251,247,.96)]\" data-kid=\"1-1\" data-name=\"marketing header\">\n        <div class=\"mx-auto flex min-h-[76px] max-w-[1180px] items-center gap-6 px-5 py-3 sm:px-8 lg:px-10\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <a aria-label=\"Cozia home\" class=\"landing-focus flex shrink-0 items-center rounded-lg px-1 py-1\" data-kid=\"1-1-1-1\" data-name=\"cozia logo link\" href=\"#top\">\n                <span class=\"landing-display text-[27px] font-semibold tracking-[-0.04em]\" data-kid=\"1-1-1-1-1\" data-name=\"cozia brand text\">\n                    Cozia\n                    <span class=\"text-[var(--ochre)]\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand dot\">\n                        .\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"Marketing navigation\" class=\"hidden items-center gap-6 lg:flex\" data-kid=\"1-1-1-2\" data-name=\"marketing navigation menu\">\n                <a class=\"landing-focus rounded-lg px-2 py-2 text-sm font-medium text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-1\" data-name=\"why cozia link\" href=\"#why-cozia\">\n                    Why Cozia\n                </a>\n                <a class=\"landing-focus rounded-lg px-2 py-2 text-sm font-medium text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-2\" data-name=\"how it works link\" href=\"#how-it-works\">\n                    How it works\n                </a>\n                <a class=\"landing-focus rounded-lg px-2 py-2 text-sm font-medium text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-3\" data-name=\"for families link\" href=\"#for-families\">\n                    For families\n                </a>\n            </nav>\n            <div class=\"ml-auto flex items-center gap-3\" data-kid=\"1-1-1-3\" data-name=\"header action buttons wrapper\">\n                <a class=\"landing-focus hidden rounded-lg px-3 py-2 text-sm font-semibold text-[var(--muted)] hover:text-[var(--ink)] sm:inline-flex sm:items-center\" data-kid=\"1-1-1-3-1\" data-name=\"sign in link\" href=\"#sign-in\">\n                    Sign in\n                </a>\n                <a class=\"landing-focus-ochre inline-flex min-h-11 items-center justify-center rounded-full bg-[var(--ochre)] px-5 text-sm font-bold text-white shadow-[0_7px_18px_rgba(212,140,70,.2)] hover:bg-[#C17A36]\" data-kid=\"1-1-1-3-2\" data-name=\"start exploring button\" href=\"#start\">\n                    Start exploring\n                </a>\n                <button aria-label=\"Open navigation menu\" class=\"landing-focus inline-flex h-11 w-11 items-center justify-center rounded-full border border-[var(--line)] bg-white text-lg text-[var(--ink)] lg:hidden\" data-kid=\"1-1-1-3-3\" data-name=\"open navigation menu button\" type=\"button\">\n                    ☰\n                </button>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-10\" data-name=\"main content area\" id=\"top\">\n        <section class=\"mx-auto grid max-w-[1180px] gap-10 px-5 pb-16 pt-12 sm:px-8 sm:pb-20 sm:pt-16 lg:grid-cols-[.9fr_1.1fr] lg:items-center lg:gap-16 lg:px-10 lg:pb-24 lg:pt-24\" data-kid=\"1-2\" data-name=\"hero section\">\n            <div class=\"max-w-[560px]\" data-kid=\"1-2-1\" data-name=\"hero copy wrapper\">\n                <p class=\"mb-5 text-xs font-bold uppercase tracking-[.18em] text-[var(--ochre)]\" data-kid=\"1-2-1-1\" data-name=\"hero subheadline\">\n                    A better way to press play\n                </p>\n                <h1 class=\"landing-display max-w-[560px] text-5xl leading-[.98] tracking-[-.045em] sm:text-6xl lg:text-[76px]\" data-kid=\"1-2-1-2\" data-name=\"hero headline text\">\n                    Good things to watch, together.\n                </h1>\n                <p class=\"mt-7 max-w-[500px] text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8\" data-kid=\"1-2-1-3\" data-name=\"hero description text\">\n                    Cozia helps families find thoughtful videos from trusted platforms, so choosing what to watch feels as good as watching it.\n                </p>\n                <div class=\"mt-8 flex flex-col gap-3 sm:flex-row\" data-kid=\"1-2-1-4\" data-name=\"hero call to action wrapper\" id=\"start\">\n                    <a class=\"landing-focus-ochre inline-flex min-h-12 items-center justify-center rounded-full bg-[var(--ink)] px-6 text-sm font-bold text-white hover:bg-[#403B37]\" data-kid=\"1-2-1-4-1\" data-name=\"primary start exploring link\" href=\"#explore\">\n                        Start exploring\n                    </a>\n                    <a class=\"landing-focus inline-flex min-h-12 items-center justify-center rounded-full border border-[var(--line)] bg-white px-6 text-sm font-bold text-[var(--ink)] hover:border-[var(--ochre)]\" data-kid=\"1-2-1-4-2\" data-name=\"secondary see how it works link\" href=\"#how-it-works\">\n                        See how it works\n                        <span aria-hidden=\"true\" class=\"ml-2 text-base\" data-kid=\"1-2-1-4-2-1\" data-name=\"arrow icon\">\n                            →\n                        </span>\n                    </a>\n                </div>\n                <p class=\"mt-6 text-sm text-[var(--faint)]\" data-kid=\"1-2-1-5\" data-name=\"hero trust tagline\">\n                    No endless feed. No noisy recommendations. Just a good next idea.\n                </p>\n            </div>\n            <div class=\"relative\" data-kid=\"1-2-2\" data-name=\"hero image panel\">\n                <div class=\"relative aspect-[4/3] overflow-hidden rounded-[22px] bg-[var(--paper-soft)] shadow-[0_18px_48px_rgba(44,42,40,.11)] sm:aspect-[5/4]\" data-kid=\"1-2-2-2\" data-name=\"image container\">\n                    <img alt=\"Family watching a movie together on a cozy couch, by Vitaly Gariev on Unsplash\" class=\"h-full w-full object-cover\" data-kid=\"1-2-2-2-1\" data-name=\"hero lifestyle image\" decoding=\"async\" loading=\"lazy\" onerror=\"this.style.display='none'\" src=\"https://images.unsplash.com/photo-1758687125866-6b9d86d41cc5?auto=format&w=1200&q=80&fit=crop\"/>\n                    <div class=\"hero-gradient absolute inset-0 bg-gradient-to-t from-[rgba(44,42,40,.36)] via-transparent to-transparent\" data-kid=\"1-2-2-2-2\" data-name=\"hero image gradient overlay\">\n                    </div>\n                </div>\n                <div class=\"absolute -bottom-5 left-5 flex items-center gap-3 rounded-[16px] bg-white px-4 py-3 shadow-[0_10px_26px_rgba(44,42,40,.1)] sm:-left-5 sm:px-5\" data-kid=\"1-2-2-1\" data-name=\"family safe note container\">\n                    <span class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[var(--sage-soft)] text-lg font-bold text-[var(--sage)]\" data-kid=\"1-2-2-1-1\" data-name=\"checkmark icon\">\n                        ✓\n                    </span>\n                    <div data-kid=\"1-2-2-1-2\" data-name=\"note text content wrapper\">\n                        <p class=\"text-sm font-bold text-[var(--ink)]\" data-kid=\"1-2-2-1-2-1\" data-name=\"note headline\">\n                            Family-safe by design\n                        </p>\n                        <p class=\"mt-0.5 text-xs text-[var(--muted)]\" data-kid=\"1-2-2-1-2-2\" data-name=\"note subheadline\">\n                            Reviewed before it reaches you\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-y border-[var(--line)] bg-white\" data-kid=\"1-3\" data-name=\"trust strip section\" id=\"why-cozia\">\n            <div class=\"mx-auto grid max-w-[1180px] gap-8 px-5 py-10 sm:grid-cols-[1.2fr_1fr_1fr_1fr] sm:px-8 lg:px-10\" data-kid=\"1-3-1\" data-name=\"trust content grid\">\n                <div data-kid=\"1-3-1-1\" data-name=\"trust section header\">\n                    <p class=\"text-xs font-bold uppercase tracking-[.16em] text-[var(--ochre)]\" data-kid=\"1-3-1-1-1\" data-name=\"trust subheadline\">\n                        The Cozia promise\n                    </p>\n                    <h2 class=\"landing-display mt-3 max-w-[270px] text-3xl leading-tight tracking-[-.03em]\" data-kid=\"1-3-1-1-2\" data-name=\"trust headline\">\n                        Thoughtful picks, not endless scrolling.\n                    </h2>\n                </div>\n                <div class=\"border-l border-[var(--line)] pl-5 sm:pl-6\" data-kid=\"1-3-1-2\" data-name=\"trust point 1\">\n                    <p class=\"text-sm font-bold text-[var(--ink)]\" data-kid=\"1-3-1-2-1\" data-name=\"trust point 1 headline\">\n                        Reviewed by people\n                    </p>\n                    <p class=\"mt-2 text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-3-1-2-2\" data-name=\"trust point 1 description\">\n                        A human point of view helps every recommendation earn its place.\n                    </p>\n                </div>\n                <div class=\"border-l border-[var(--line)] pl-5 sm:pl-6\" data-kid=\"1-3-1-3\" data-name=\"trust point 2\">\n                    <p class=\"text-sm font-bold text-[var(--ink)]\" data-kid=\"1-3-1-3-1\" data-name=\"trust point 2 headline\">\n                        Made for shared time\n                    </p>\n                    <p class=\"mt-2 text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-3-1-3-2\" data-name=\"trust point 2 description\">\n                        Find stories, questions, and discoveries worth bringing to the sofa.\n                    </p>\n                </div>\n                <div class=\"border-l border-[var(--line)] pl-5 sm:pl-6\" data-kid=\"1-3-1-4\" data-name=\"trust point 3\">\n                    <p class=\"text-sm font-bold text-[var(--ink)]\" data-kid=\"1-3-1-4-1\" data-name=\"trust point 3 headline\">\n                        Trusted platforms\n                    </p>\n                    <p class=\"mt-2 text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-3-1-4-2\" data-name=\"trust point 3 description\">\n                        Your good next idea can come from YouTube, Vimeo, Dailymotion, or Twitch.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto grid max-w-[1180px] gap-10 px-5 py-20 sm:px-8 lg:grid-cols-[1.08fr_.92fr] lg:items-center lg:gap-20 lg:px-10 lg:py-28\" data-kid=\"1-4\" data-name=\"feature story section\" id=\"for-families\">\n            <div class=\"relative overflow-hidden rounded-[20px] bg-[var(--paper-soft)] shadow-[0_14px_36px_rgba(44,42,40,.08)]\" data-kid=\"1-4-1\" data-name=\"feature image panel\">\n                <img alt=\"Child conducting a science experiment at home, by Tim Mossholder on Unsplash\" class=\"aspect-[4/3] h-full w-full object-cover\" data-kid=\"1-4-1-1\" data-name=\"feature image\" decoding=\"async\" loading=\"lazy\" onerror=\"this.style.display='none'\" src=\"https://images.unsplash.com/photo-1648420325597-d1c217004985?auto=format&w=1000&q=80&fit=crop\"/>\n                <span class=\"absolute bottom-4 left-4 rounded-full bg-white/95 px-3 py-2 text-xs font-bold text-[var(--sage)] shadow-sm\" data-kid=\"1-4-1-2\" data-name=\"feature image label\">\n                    A little wonder, every day\n                </span>\n            </div>\n            <div class=\"max-w-[500px]\" data-kid=\"1-4-2\" data-name=\"feature copy wrapper\">\n                <p class=\"text-xs font-bold uppercase tracking-[.16em] text-[var(--sage)]\" data-kid=\"1-4-2-1\" data-name=\"feature subheadline\">\n                    Curated for curiosity\n                </p>\n                <h2 class=\"landing-display mt-4 text-4xl leading-[1.03] tracking-[-.035em] sm:text-5xl\" data-kid=\"1-4-2-2\" data-name=\"feature headline\">\n                    Make room for wonder.\n                </h2>\n                <p class=\"mt-6 text-base leading-8 text-[var(--muted)]\" data-kid=\"1-4-2-3\" data-name=\"feature description text\">\n                    The internet is full of brilliant things. Cozia helps you reach the good ones sooner, with a considered collection that gives every family member something to lean into.\n                </p>\n                <a class=\"landing-focus mt-7 inline-flex items-center rounded-lg py-2 text-sm font-bold text-[var(--sage)] hover:text-[var(--ink)]\" data-kid=\"1-4-2-4\" data-name=\"feature explore collection link\" href=\"#explore\">\n                    Explore the collection\n                    <span aria-hidden=\"true\" class=\"ml-2 text-base\" data-kid=\"1-4-2-4-1\" data-name=\"arrow icon\">\n                        →\n                    </span>\n                </a>\n            </div>\n        </section>\n        <section class=\"bg-[var(--paper-soft)]\" data-kid=\"1-5\" data-name=\"benefits section\" id=\"explore\">\n            <div class=\"mx-auto max-w-[1180px] px-5 py-20 sm:px-8 lg:px-10 lg:py-24\" data-kid=\"1-5-1\" data-name=\"benefits content wrapper\">\n                <div class=\"max-w-[530px]\" data-kid=\"1-5-1-1\" data-name=\"benefits section header\">\n                    <p class=\"text-xs font-bold uppercase tracking-[.16em] text-[var(--ochre)]\" data-kid=\"1-5-1-1-1\" data-name=\"benefits subheadline\">\n                        What changes when you choose Cozia\n                    </p>\n                    <h2 class=\"landing-display mt-4 text-4xl leading-tight tracking-[-.03em] sm:text-5xl\" data-kid=\"1-5-1-1-2\" data-name=\"benefits headline\">\n                        A little less noise. A lot more together.\n                    </h2>\n                </div>\n                <div class=\"mt-12 grid gap-10 md:grid-cols-3 md:gap-8\" data-kid=\"1-5-1-2\" data-name=\"benefits grid\">\n                    <article class=\"border-t-2 border-[var(--ink)] pt-5\" data-kid=\"1-5-1-2-1\" data-name=\"benefit 1 card\">\n                        <p class=\"text-sm font-bold text-[var(--ochre)]\" data-kid=\"1-5-1-2-1-1\" data-name=\"benefit 1 index\">\n                            01\n                        </p>\n                        <h3 class=\"landing-display mt-4 text-2xl\" data-kid=\"1-5-1-2-1-2\" data-name=\"benefit 1 title\">\n                            Find your next favorite\n                        </h3>\n                        <p class=\"mt-3 text-sm leading-7 text-[var(--muted)]\" data-kid=\"1-5-1-2-1-3\" data-name=\"benefit 1 description\">\n                            Browse with a point of view, not an algorithmic avalanche. Start with a mood, a question, or a shared interest.\n                        </p>\n                    </article>\n                    <article class=\"border-t-2 border-[var(--sage)] pt-5\" data-kid=\"1-5-1-2-2\" data-name=\"benefit 2 card\">\n                        <p class=\"text-sm font-bold text-[var(--sage)]\" data-kid=\"1-5-1-2-2-1\" data-name=\"benefit 2 index\">\n                            02\n                        </p>\n                        <h3 class=\"landing-display mt-4 text-2xl\" data-kid=\"1-5-1-2-2-2\" data-name=\"benefit 2 title\">\n                            Keep the good stuff close\n                        </h3>\n                        <p class=\"mt-3 text-sm leading-7 text-[var(--muted)]\" data-kid=\"1-5-1-2-2-3\" data-name=\"benefit 2 description\">\n                            Save the videos that spark a smile or a conversation, then come back when the moment is right.\n                        </p>\n                    </article>\n                    <article class=\"border-t-2 border-[var(--ochre)] pt-5\" data-kid=\"1-5-1-2-3\" data-name=\"benefit 3 card\">\n                        <p class=\"text-sm font-bold text-[var(--ochre)]\" data-kid=\"1-5-1-2-3-1\" data-name=\"benefit 3 index\">\n                            03\n                        </p>\n                        <h3 class=\"landing-display mt-4 text-2xl\" data-kid=\"1-5-1-2-3-2\" data-name=\"benefit 3 title\">\n                            Watch with confidence\n                        </h3>\n                        <p class=\"mt-3 text-sm leading-7 text-[var(--muted)]\" data-kid=\"1-5-1-2-3-3\" data-name=\"benefit 3 description\">\n                            Clear family-safe signals and human review make choosing feel lighter for everyone in the room.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-[1180px] px-5 py-20 sm:px-8 lg:px-10 lg:py-28\" data-kid=\"1-6\" data-name=\"how it works section\" id=\"how-it-works\">\n            <div class=\"flex flex-col justify-between gap-5 sm:flex-row sm:items-end\" data-kid=\"1-6-1\" data-name=\"how it works header wrapper\">\n                <div data-kid=\"1-6-1-1\" data-name=\"how it works section header\">\n                    <p class=\"text-xs font-bold uppercase tracking-[.16em] text-[var(--sage)]\" data-kid=\"1-6-1-1-1\" data-name=\"how it works subheadline\">\n                        How it works\n                    </p>\n                    <h2 class=\"landing-display mt-4 text-4xl tracking-[-.03em] sm:text-5xl\" data-kid=\"1-6-1-1-2\" data-name=\"how it works headline\">\n                        Simple by design.\n                    </h2>\n                </div>\n                <p class=\"max-w-[330px] text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-6-1-2\" data-name=\"how it works description\">\n                    A gentler rhythm for finding something you will be glad you watched.\n                </p>\n            </div>\n            <div class=\"mt-12 grid gap-0 border-y border-[var(--line)] md:grid-cols-3\" data-kid=\"1-6-2\" data-name=\"how it works grid\">\n                <article class=\"border-b border-[var(--line)] py-8 md:border-b-0 md:border-r md:pr-8\" data-kid=\"1-6-2-1\" data-name=\"process step 1\">\n                    <p class=\"landing-display text-5xl text-[var(--ochre)]\" data-kid=\"1-6-2-1-1\" data-name=\"process step 1 number\">\n                        1\n                    </p>\n                    <h3 class=\"mt-5 text-lg font-bold\" data-kid=\"1-6-2-1-2\" data-name=\"process step 1 title\">\n                        Pick a mood\n                    </h3>\n                    <p class=\"mt-3 text-sm leading-7 text-[var(--muted)]\" data-kid=\"1-6-2-1-3\" data-name=\"process step 1 description\">\n                        Choose from a thoughtful shelf made for the kind of time you have.\n                    </p>\n                </article>\n                <article class=\"border-b border-[var(--line)] py-8 md:border-b-0 md:border-r md:px-8\" data-kid=\"1-6-2-2\" data-name=\"process step 2\">\n                    <p class=\"landing-display text-5xl text-[var(--sage)]\" data-kid=\"1-6-2-2-1\" data-name=\"process step 2 number\">\n                        2\n                    </p>\n                    <h3 class=\"mt-5 text-lg font-bold\" data-kid=\"1-6-2-2-2\" data-name=\"process step 2 title\">\n                        Press play\n                    </h3>\n                    <p class=\"mt-3 text-sm leading-7 text-[var(--muted)]\" data-kid=\"1-6-2-2-3\" data-name=\"process step 2 description\">\n                        Find the title that catches your eye and settle into the story.\n                    </p>\n                </article>\n                <article class=\"py-8 md:pl-8\" data-kid=\"1-6-2-3\" data-name=\"process step 3\">\n                    <p class=\"landing-display text-5xl text-[var(--ochre)]\" data-kid=\"1-6-2-3-1\" data-name=\"process step 3 number\">\n                        3\n                    </p>\n                    <h3 class=\"mt-5 text-lg font-bold\" data-kid=\"1-6-2-3-2\" data-name=\"process step 3 title\">\n                        Make it a ritual\n                    </h3>\n                    <p class=\"mt-3 text-sm leading-7 text-[var(--muted)]\" data-kid=\"1-6-2-3-3\" data-name=\"process step 3 description\">\n                        Save what works, share what you loved, and make room for the next good idea.\n                    </p>\n                </article>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-[1180px] px-5 pb-20 sm:px-8 lg:px-10 lg:pb-28\" data-kid=\"1-7\" data-name=\"family quote band\">\n            <div class=\"grid overflow-hidden rounded-[22px] bg-[var(--ink)] text-white md:grid-cols-[.8fr_1.2fr]\" data-kid=\"1-7-1\" data-name=\"quote band inner container\">\n                <div class=\"relative min-h-[300px] bg-[var(--paper-soft)]\" data-kid=\"1-7-1-1\" data-name=\"quote band image container\">\n                    <img alt=\"Parent and child reading a book outdoors, by Andy Kuzma on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-7-1-1-1\" data-name=\"family lifestyle image\" decoding=\"async\" loading=\"lazy\" onerror=\"this.style.display='none'\" src=\"https://images.pexels.com/photos/2801567/pexels-photo-2801567.jpeg?auto=compress&cs=tinysrgb&w=900&q=80\"/>\n                </div>\n                <div class=\"flex flex-col justify-center p-8 sm:p-12 lg:p-16\" data-kid=\"1-7-1-2\" data-name=\"quote content wrapper\">\n                    <p class=\"text-xs font-bold uppercase tracking-[.16em] text-[#F7D8B5]\" data-kid=\"1-7-1-2-1\" data-name=\"quote label\">\n                        A note from a Cozia family\n                    </p>\n                    <blockquote class=\"landing-display mt-5 max-w-[560px] text-3xl leading-tight tracking-[-.025em] sm:text-4xl\" data-kid=\"1-7-1-2-2\" data-name=\"blockquote text\">\n                        “The part we love most is choosing something we can all talk about.”\n                    </blockquote>\n                    <p class=\"mt-6 text-sm text-white/70\" data-kid=\"1-7-1-2-3\" data-name=\"quote attribution\">\n                        — A Cozia family\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-y border-[var(--line)] bg-white\" data-kid=\"1-8\" data-name=\"closing call to action section\">\n            <div class=\"mx-auto flex max-w-[1180px] flex-col items-start justify-between gap-8 px-5 py-16 sm:px-8 md:flex-row md:items-center lg:px-10 lg:py-20\" data-kid=\"1-8-1\" data-name=\"cta inner container\">\n                <div data-kid=\"1-8-1-1\" data-name=\"cta text wrapper\">\n                    <p class=\"text-xs font-bold uppercase tracking-[.16em] text-[var(--ochre)]\" data-kid=\"1-8-1-1-1\" data-name=\"cta subheadline\">\n                        Keep the feeling going\n                    </p>\n                    <h2 class=\"landing-display mt-4 text-4xl tracking-[-.03em] sm:text-5xl\" data-kid=\"1-8-1-1-2\" data-name=\"cta headline\">\n                        Save your next good idea.\n                    </h2>\n                    <p class=\"mt-4 max-w-[520px] text-base leading-7 text-[var(--muted)]\" data-kid=\"1-8-1-1-3\" data-name=\"cta description\">\n                        Start with one thoughtful pick. Keep the ones that become part of your family’s story.\n                    </p>\n                </div>\n                <a class=\"landing-focus-ochre inline-flex min-h-14 w-full items-center justify-center rounded-full bg-[var(--ochre)] px-7 text-sm font-bold text-white shadow-[0_8px_20px_rgba(212,140,70,.2)] hover:bg-[#C17A36] sm:w-auto\" data-kid=\"1-8-1-2\" data-name=\"cta start exploring link\" href=\"#start\">\n                    Start exploring Cozia\n                    <span aria-hidden=\"true\" class=\"ml-2 text-base\" data-kid=\"1-8-1-2-1\" data-name=\"arrow icon\">\n                        →\n                    </span>\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"mx-auto flex max-w-[1180px] flex-col gap-6 px-5 py-9 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-10\" data-kid=\"1-9\" data-name=\"minimal footer\">\n        <div class=\"flex items-center gap-2\" data-kid=\"1-9-1\" data-name=\"footer branding wrapper\">\n            <span class=\"landing-display text-xl font-semibold\" data-kid=\"1-9-1-1\" data-name=\"footer brand name\">\n                Cozia\n                <span class=\"text-[var(--ochre)]\" data-kid=\"1-9-1-1-1\" data-name=\"brand dot\">\n                    .\n                </span>\n            </span>\n            <span class=\"text-sm text-[var(--faint)]\" data-kid=\"1-9-1-2\" data-name=\"footer tagline\">\n                A calmer corner of the internet.\n            </span>\n        </div>\n        <nav aria-label=\"Footer navigation\" class=\"flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-[var(--muted)]\" data-kid=\"1-9-2\" data-name=\"footer navigation\">\n            <a class=\"landing-focus rounded-lg py-2 hover:text-[var(--ink)]\" data-kid=\"1-9-2-1\" data-name=\"privacy link\" href=\"#privacy\">\n                Privacy\n            </a>\n            <a class=\"landing-focus rounded-lg py-2 hover:text-[var(--ink)]\" data-kid=\"1-9-2-2\" data-name=\"community guidelines link\" href=\"#guidelines\">\n                Community guidelines\n            </a>\n            <a class=\"landing-focus rounded-lg py-2 hover:text-[var(--ink)]\" data-kid=\"1-9-2-3\" data-name=\"terms link\" href=\"#terms\">\n                Terms\n            </a>\n        </nav>\n    </footer>\n</div>\n",
