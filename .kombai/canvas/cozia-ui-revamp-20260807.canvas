      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap');\n  :root {\n    --paper: #FDFBF7;\n    --paper-soft: #F6F1EA;\n    --card: #FFFFFF;\n    --ink: #2C2A28;\n    --muted: #5E5955;\n    --faint: #867F78;\n    --ochre: #D48C46;\n    --ochre-soft: #F3E3D1;\n    --sage: #4A7C73;\n    --sage-soft: #E3EFEB;\n    --line: #E9E2DA;\n  }\n  .cozia-page { font-family: 'Manrope', sans-serif; background: var(--paper); color: var(--ink); }\n  .cozia-display { font-family: 'Fraunces', serif; }\n  .cozia-focus:focus-visible { outline: 2px solid var(--sage); outline-offset: 4px; }\n  .cozia-focus-ochre:focus-visible { outline: 2px solid var(--ochre); outline-offset: 4px; }\n  .cozia-page a, .cozia-page button { min-height: 44px; }\n  .cozia-page img { display: block; }\n  .topic-scroll { scrollbar-width: none; -ms-overflow-style: none; }\n  .topic-scroll::-webkit-scrollbar { display: none; }\n  @media (max-width: 767px) {\n    .hero-copy { background: linear-gradient(180deg, transparent 8%, rgba(44,42,40,.92) 74%); }\n  }\n</style>\n<div class=\"cozia-page min-h-screen\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"relative z-30 border-b border-[var(--line)] bg-[rgba(253,251,247,.96)]\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"mx-auto flex min-h-[76px] max-w-[1240px] items-center gap-5 px-5 py-3 sm:px-8 lg:px-10\" data-kid=\"1-1-1\" data-name=\"header content container\">\n            <a aria-label=\"Cozia home\" class=\"cozia-focus flex shrink-0 items-center gap-2 rounded-lg px-1 py-1\" data-kid=\"1-1-1-1\" data-name=\"home link\" href=\"#\">\n                <span class=\"cozia-display text-[27px] font-semibold tracking-[-0.04em]\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo text\">\n                    Cozia\n                    <span class=\"text-[var(--ochre)]\" data-kid=\"1-1-1-1-1-1\" data-name=\"logo dot\">\n                        .\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"hidden items-center gap-5 lg:flex\" data-kid=\"1-1-1-2\" data-name=\"primary navigation menu\">\n                <a class=\"cozia-focus rounded-lg px-2 py-2 text-sm font-semibold text-[var(--ink)]\" data-kid=\"1-1-1-2-1\" data-name=\"watch navigation link\" href=\"#watch\">\n                    Watch\n                </a>\n                <a class=\"cozia-focus rounded-lg px-2 py-2 text-sm font-medium text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-2\" data-name=\"shorts navigation link\" href=\"#shorts\">\n                    Shorts\n                </a>\n                <a class=\"cozia-focus rounded-lg px-2 py-2 text-sm font-medium text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-3\" data-name=\"live navigation link\" href=\"#live\">\n                    Live\n                </a>\n                <a class=\"cozia-focus rounded-lg px-2 py-2 text-sm font-medium text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-4\" data-name=\"community navigation link\" href=\"#community\">\n                    Community\n                </a>\n            </nav>\n            <div class=\"ml-auto flex min-w-0 items-center gap-3\" data-kid=\"1-1-1-3\" data-name=\"header action button container\">\n                <label class=\"cozia-focus hidden h-11 min-w-0 flex-1 items-center gap-2 rounded-full border border-[var(--line)] bg-white px-4 text-[var(--muted)] shadow-[0_2px_12px_rgba(44,42,40,.04)] sm:flex sm:w-[260px] lg:w-[330px]\" data-kid=\"1-1-1-3-1\" data-name=\"search input container\">\n                    <span aria-hidden=\"true\" class=\"text-lg leading-none\" data-kid=\"1-1-1-3-1-1\" data-name=\"search magnifying glass icon\">\n                        ⌕\n                    </span>\n                    <input aria-label=\"Search thoughtful videos\" class=\"min-w-0 flex-1 bg-transparent text-sm text-[var(--ink)] placeholder:text-[var(--faint)] focus:outline-none\" data-kid=\"1-1-1-3-1-2\" data-name=\"search input field\" placeholder=\"Search thoughtful videos\" type=\"search\"/>\n                </label>\n                <button class=\"cozia-focus-ochre hidden h-11 shrink-0 items-center gap-2 rounded-full border border-[var(--ochre)]/30 bg-[var(--ochre-soft)] px-4 text-sm font-semibold text-[var(--ink)] sm:flex\" data-kid=\"1-1-1-3-2\" data-name=\"kids mode toggle button\" type=\"button\">\n                    <span aria-hidden=\"true\" class=\"text-base\" data-kid=\"1-1-1-3-2-1\" data-name=\"kids mode star icon\">\n                        ✦\n                    </span>\n                    <span data-kid=\"1-1-1-3-2-2\" data-name=\"kids mode button label\">\n                        Kids mode\n                    </span>\n                </button>\n                <button class=\"cozia-focus-ochre hidden h-11 shrink-0 rounded-full bg-[var(--ochre)] px-4 text-sm font-bold text-white shadow-[0_6px_16px_rgba(212,140,70,.2)] md:block\" data-kid=\"1-1-1-3-3\" data-name=\"nominate button\" type=\"button\">\n                    Nominate\n                </button>\n                <button aria-label=\"Open profile\" class=\"cozia-focus h-11 w-11 shrink-0 overflow-hidden rounded-full border-2 border-white bg-[var(--ochre-soft)] shadow-sm\" data-kid=\"1-1-1-3-4\" data-name=\"open profile button\" type=\"button\">\n                    <img alt=\"Profile avatar\" class=\"h-full w-full object-cover\" data-kid=\"1-1-1-3-4-1\" data-name=\"profile avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&w=128&q=80&fit=crop\"/>\n                </button>\n            </div>\n        </div>\n        <div aria-label=\"Browse topics\" class=\"mx-auto flex max-w-[1240px] items-center gap-2 overflow-x-auto px-5 pb-3 sm:px-8 lg:px-10 topic-scroll\" data-kid=\"1-1-2\" data-name=\"browse topics navigation bar\">\n            <span class=\"mr-2 shrink-0 text-xs font-bold uppercase tracking-[.14em] text-[var(--faint)]\" data-kid=\"1-1-2-1\" data-name=\"browse label\">\n                Browse\n            </span>\n            <a class=\"cozia-focus-ochre shrink-0 rounded-full bg-[var(--ink)] px-4 py-2 text-sm font-semibold text-white\" data-kid=\"1-1-2-2\" data-name=\"family picks topic link\" href=\"#family-picks\">\n                Family picks\n            </a>\n            <a class=\"cozia-focus-ochre shrink-0 rounded-full border border-[var(--line)] bg-white px-4 py-2 text-sm text-[var(--muted)] hover:border-[var(--ochre)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-3\" data-name=\"educational topic link\" href=\"#learn\">\n                Educational\n            </a>\n            <a class=\"cozia-focus-ochre shrink-0 rounded-full border border-[var(--line)] bg-white px-4 py-2 text-sm text-[var(--muted)] hover:border-[var(--ochre)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-4\" data-name=\"short films topic link\" href=\"#shorts\">\n                Short films\n            </a>\n            <a class=\"cozia-focus-ochre shrink-0 rounded-full border border-[var(--line)] bg-white px-4 py-2 text-sm text-[var(--muted)] hover:border-[var(--ochre)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-5\" data-name=\"science topic link\" href=\"#learn\">\n                Science\n            </a>\n            <a class=\"cozia-focus-ochre shrink-0 rounded-full border border-[var(--line)] bg-white px-4 py-2 text-sm text-[var(--muted)] hover:border-[var(--ochre)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-6\" data-name=\"live now topic link\" href=\"#live\">\n                Live now\n            </a>\n            <a class=\"cozia-focus-ochre shrink-0 rounded-full border border-[var(--line)] bg-white px-4 py-2 text-sm text-[var(--muted)] hover:border-[var(--ochre)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-7\" data-name=\"storytime topic link\" href=\"#community\">\n                Storytime\n            </a>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1240px] px-5 pb-28 pt-7 sm:px-8 sm:pt-10 lg:px-10 lg:pb-16\" data-kid=\"1-2\" data-name=\"main content area\" id=\"watch\">\n        <section aria-labelledby=\"hero-title\" class=\"relative min-h-[500px] overflow-hidden rounded-[20px] bg-[#51483f] shadow-[0_18px_50px_rgba(44,42,40,.12)] sm:min-h-[540px]\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <img alt=\"Family watching a movie together on a cozy couch, by Vitaly Gariev on Unsplash\" class=\"absolute inset-0 h-full w-full object-cover\" data-kid=\"1-2-1-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1758687125866-6b9d86d41cc5?auto=format&w=1600&q=80&fit=crop\"/>\n            <div class=\"absolute inset-0 bg-gradient-to-r from-[rgba(44,42,40,.9)] via-[rgba(44,42,40,.48)] to-[rgba(44,42,40,.08)]\" data-kid=\"1-2-1-2\" data-name=\"hero image gradient overlay\">\n            </div>\n            <div class=\"hero-copy absolute inset-0 flex items-end p-7 sm:p-10 lg:p-14\" data-kid=\"1-2-1-3\" data-name=\"hero content container\">\n                <div class=\"max-w-[560px] text-white\" data-kid=\"1-2-1-3-1\" data-name=\"hero text container\">\n                    <p class=\"mb-4 text-xs font-bold uppercase tracking-[.18em] text-[#F7D8B5]\" data-kid=\"1-2-1-3-1-1\" data-name=\"hero pre-headline category label\">\n                        Family pick of the day\n                    </p>\n                    <h1 class=\"cozia-display max-w-[500px] text-5xl leading-[.98] tracking-[-.04em] sm:text-6xl lg:text-[72px]\" data-kid=\"1-2-1-3-1-2\" data-name=\"hero main headline text\" id=\"hero-title\">\n                        Make room for wonder.\n                    </h1>\n                    <p class=\"mt-5 max-w-[470px] text-base leading-7 text-white/85 sm:text-lg\" data-kid=\"1-2-1-3-1-3\" data-name=\"hero description text\">\n                        Discover thoughtful videos that turn a quiet evening into a shared adventure, a question, or a story worth talking about.\n                    </p>\n                    <div class=\"mt-8 flex flex-col gap-3 sm:flex-row\" data-kid=\"1-2-1-3-1-4\" data-name=\"hero button container\">\n                        <button class=\"cozia-focus-ochre inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-white px-6 text-sm font-bold text-[var(--ink)] shadow-lg hover:bg-[#fff7ef]\" data-kid=\"1-2-1-3-1-4-1\" data-name=\"play featured pick button\" type=\"button\">\n                            <span aria-hidden=\"true\" class=\"text-lg\" data-kid=\"1-2-1-3-1-4-1-1\" data-name=\"play icon\">\n                                ▶\n                            </span>\n                            Play featured pick\n                        </button>\n                        <button class=\"cozia-focus inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/50 bg-white/10 px-6 text-sm font-semibold text-white backdrop-blur-sm hover:bg-white/20\" data-kid=\"1-2-1-3-1-4-2\" data-name=\"save for later button\" type=\"button\">\n                            <span aria-hidden=\"true\" class=\"text-lg\" data-kid=\"1-2-1-3-1-4-2-1\" data-name=\"plus icon\">\n                                ＋\n                            </span>\n                            Save for later\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"recommended-title\" class=\"mt-14\" data-kid=\"1-2-2\" data-name=\"recommended section\" id=\"family-picks\">\n            <div class=\"mb-6 flex items-end justify-between gap-4\" data-kid=\"1-2-2-1\" data-name=\"recommended header\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"recommended title group\">\n                    <p class=\"mb-2 text-xs font-bold uppercase tracking-[.16em] text-[var(--ochre)]\" data-kid=\"1-2-2-1-1-1\" data-name=\"recommended pre-headline\">\n                        A thoughtful starting point\n                    </p>\n                    <h2 class=\"cozia-display text-3xl tracking-[-.03em] sm:text-4xl\" data-kid=\"1-2-2-1-1-2\" data-name=\"recommended headline\" id=\"recommended-title\">\n                        Recommended for your family\n                    </h2>\n                </div>\n                <a class=\"cozia-focus-ochre hidden rounded-lg px-2 py-2 text-sm font-semibold text-[var(--muted)] hover:text-[var(--ink)] sm:block\" data-kid=\"1-2-2-1-2\" data-name=\"view all recommended link\" href=\"#all-picks\">\n                    View all\n                    <span aria-hidden=\"true\" data-kid=\"1-2-2-1-2-1\" data-name=\"arrow icon\">\n                        →\n                    </span>\n                </a>\n            </div>\n            <div class=\"grid gap-6 lg:grid-cols-[1.45fr_1fr]\" data-kid=\"1-2-2-2\" data-name=\"recommended grid container\">\n                <article class=\"group overflow-hidden rounded-[18px] bg-white shadow-[0_8px_28px_rgba(44,42,40,.07)]\" data-kid=\"1-2-2-2-1\" data-name=\"featured article\">\n                    <div class=\"relative aspect-[16/9] overflow-hidden bg-[var(--paper-soft)]\" data-kid=\"1-2-2-2-1-1\" data-name=\"featured article thumbnail container\">\n                        <img alt=\"Child conducting a science experiment at home, by Tim Mossholder on Unsplash\" class=\"h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"featured article image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1648420325597-d1c217004985?auto=format&w=1200&q=80&fit=crop\"/>\n                        <span class=\"absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1.5 text-xs font-bold text-[var(--sage)] shadow-sm\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"editor's pick badge\">\n                            Editor's pick\n                        </span>\n                        <span class=\"absolute bottom-4 right-4 rounded-full bg-[rgba(44,42,40,.82)] px-2.5 py-1 text-xs font-semibold text-white\" data-kid=\"1-2-2-2-1-1-3\" data-name=\"video duration badge\">\n                            4:15\n                        </span>\n                    </div>\n                    <div class=\"p-6 sm:p-7\" data-kid=\"1-2-2-2-1-2\" data-name=\"featured article text\">\n                        <h3 class=\"cozia-display text-2xl leading-tight tracking-[-.02em] sm:text-3xl\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"featured article title\">\n                            Kids science experiments with Skittles\n                        </h3>\n                        <p class=\"mt-2 text-sm text-[var(--muted)]\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"featured article meta\">\n                            Cozia Educational · Science for curious minds\n                        </p>\n                        <p class=\"mt-4 text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-2-2-1-2-3\" data-name=\"featured article description\">\n                            A bright, hands-on experiment that makes a little kitchen magic feel wonderfully explainable.\n                        </p>\n                        <button class=\"cozia-focus-ochre mt-5 inline-flex min-h-11 items-center gap-2 rounded-full border border-[var(--line)] px-4 text-sm font-bold text-[var(--ink)] hover:border-[var(--ochre)]\" data-kid=\"1-2-2-2-1-2-4\" data-name=\"watch now button\" type=\"button\">\n                            <span aria-hidden=\"true\" data-kid=\"1-2-2-2-1-2-4-1\" data-name=\"play arrow icon\">\n                                ▶\n                            </span>\n                            Watch now\n                        </button>\n                    </div>\n                </article>\n                <div class=\"grid gap-6 sm:grid-cols-2 lg:grid-cols-1\" data-kid=\"1-2-2-2-2\" data-name=\"sidebar grid container\">\n                    <article class=\"group grid grid-cols-[132px_1fr] overflow-hidden rounded-[18px] bg-white shadow-[0_8px_28px_rgba(44,42,40,.05)] sm:grid-cols-[150px_1fr] lg:grid-cols-[180px_1fr]\" data-kid=\"1-2-2-2-2-1\" data-name=\"sidebar article 1\">\n                        <div class=\"relative min-h-[148px] overflow-hidden bg-[var(--paper-soft)]\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"sidebar thumbnail container 1\">\n                            <img alt=\"Family watching a video together, by Vitaly Gariev on Unsplash\" class=\"h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"sidebar image 1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1758687125679-d000e186e09b?auto=format&w=520&q=80&fit=crop\"/>\n                            <span class=\"absolute bottom-3 left-3 rounded-full bg-[rgba(44,42,40,.8)] px-2 py-1 text-[12px] font-semibold text-white\" data-kid=\"1-2-2-2-2-1-1-2\" data-name=\"video duration badge 1\">\n                                8:40\n                            </span>\n                        </div>\n                        <div class=\"flex flex-col justify-center p-5\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"sidebar text 1\">\n                            <p class=\"text-xs font-bold uppercase tracking-[.12em] text-[var(--ochre)]\" data-kid=\"1-2-2-2-2-1-2-1\" data-name=\"sidebar pre-headline 1\">\n                                Watch together\n                            </p>\n                            <h3 class=\"cozia-display mt-2 text-xl leading-tight\" data-kid=\"1-2-2-2-2-1-2-2\" data-name=\"sidebar headline 1\">\n                                Top life skills lessons for curious kids\n                            </h3>\n                            <p class=\"mt-2 text-sm text-[var(--muted)]\" data-kid=\"1-2-2-2-2-1-2-3\" data-name=\"sidebar meta 1\">\n                                Cozia Educational\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"group grid grid-cols-[132px_1fr] overflow-hidden rounded-[18px] bg-white shadow-[0_8px_28px_rgba(44,42,40,.05)] sm:grid-cols-[150px_1fr] lg:grid-cols-[180px_1fr]\" data-kid=\"1-2-2-2-2-2\" data-name=\"sidebar article 2\">\n                        <div class=\"relative min-h-[148px] overflow-hidden bg-[var(--paper-soft)]\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"sidebar thumbnail container 2\">\n                            <img alt=\"Young girl painting at a table, by Jonathan Borba on Unsplash\" class=\"h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]\" data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"sidebar image 2\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1769720204501-75e6a3c25d3d?auto=format&w=520&q=80&fit=crop\"/>\n                            <span class=\"absolute bottom-3 left-3 rounded-full bg-[rgba(44,42,40,.8)] px-2 py-1 text-[12px] font-semibold text-white\" data-kid=\"1-2-2-2-2-2-1-2\" data-name=\"video duration badge 2\">\n                                5:00\n                            </span>\n                        </div>\n                        <div class=\"flex flex-col justify-center p-5\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"sidebar text 2\">\n                            <p class=\"text-xs font-bold uppercase tracking-[.12em] text-[var(--sage)]\" data-kid=\"1-2-2-2-2-2-2-1\" data-name=\"sidebar pre-headline 2\">\n                                Make something\n                            </p>\n                            <h3 class=\"cozia-display mt-2 text-xl leading-tight\" data-kid=\"1-2-2-2-2-2-2-2\" data-name=\"sidebar headline 2\">\n                                A gentle guide to creative afternoons\n                            </h3>\n                            <p class=\"mt-2 text-sm text-[var(--muted)]\" data-kid=\"1-2-2-2-2-2-2-3\" data-name=\"sidebar meta 2\">\n                                Cozia Family Picks\n                            </p>\n                        </div>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"learn-title\" class=\"mt-16\" data-kid=\"1-2-3\" data-name=\"learning section\" id=\"learn\">\n            <div class=\"mb-6 flex items-end justify-between gap-4\" data-kid=\"1-2-3-1\" data-name=\"learning section header\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"learning section title group\">\n                    <p class=\"mb-2 text-xs font-bold uppercase tracking-[.16em] text-[var(--sage)]\" data-kid=\"1-2-3-1-1-1\" data-name=\"learning section pre-headline\">\n                        Curiosity, shared\n                    </p>\n                    <h2 class=\"cozia-display text-3xl tracking-[-.03em] sm:text-4xl\" data-kid=\"1-2-3-1-1-2\" data-name=\"learning section headline\" id=\"learn-title\">\n                        Learn something together\n                    </h2>\n                </div>\n                <a class=\"cozia-focus-ochre rounded-lg px-2 py-2 text-sm font-semibold text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-2-3-1-2\" data-name=\"view all learning link\" href=\"#all-learning\">\n                    View all\n                    <span aria-hidden=\"true\" data-kid=\"1-2-3-1-2-1\" data-name=\"arrow icon\">\n                        →\n                    </span>\n                </a>\n            </div>\n            <div class=\"flex gap-5 overflow-x-auto pb-3 topic-scroll\" data-kid=\"1-2-3-2\" data-name=\"learning article carousel\">\n                <article class=\"group min-w-[250px] flex-1 overflow-hidden rounded-[18px] bg-white shadow-[0_8px_24px_rgba(44,42,40,.05)] sm:min-w-[270px]\" data-kid=\"1-2-3-2-1\" data-name=\"learning article 1\">\n                    <div class=\"relative aspect-[4/3] overflow-hidden bg-[var(--paper-soft)]\" data-kid=\"1-2-3-2-1-1\" data-name=\"learning article thumbnail container 1\">\n                        <img alt=\"Child exploring a hands-on project, by Tim Mossholder on Unsplash\" class=\"h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"learning article image 1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1648420325602-0476ebe076d9?auto=format&w=640&q=80&fit=crop\"/>\n                        <span class=\"absolute bottom-3 right-3 rounded-full bg-[rgba(44,42,40,.82)] px-2.5 py-1 text-xs font-semibold text-white\" data-kid=\"1-2-3-2-1-1-2\" data-name=\"video duration badge 1\">\n                            4:15\n                        </span>\n                    </div>\n                    <div class=\"p-5\" data-kid=\"1-2-3-2-1-2\" data-name=\"learning article text 1\">\n                        <h3 class=\"cozia-display text-xl leading-tight\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"learning article headline 1\">\n                            Why does an egg float?\n                        </h3>\n                        <p class=\"mt-2 text-sm text-[var(--muted)]\" data-kid=\"1-2-3-2-1-2-2\" data-name=\"learning article meta 1\">\n                            Simple science · 4 min\n                        </p>\n                    </div>\n                </article>\n                <article class=\"group min-w-[250px] flex-1 overflow-hidden rounded-[18px] bg-white shadow-[0_8px_24px_rgba(44,42,40,.05)] sm:min-w-[270px]\" data-kid=\"1-2-3-2-2\" data-name=\"learning article 2\">\n                    <div class=\"relative aspect-[4/3] overflow-hidden bg-[var(--paper-soft)]\" data-kid=\"1-2-3-2-2-1\" data-name=\"learning article thumbnail container 2\">\n                        <img alt=\"Young girl conducting a table-top activity, by Tim Mossholder on Unsplash\" class=\"h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"learning article image 2\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1648420325217-c8a1f20a6c29?auto=format&w=640&q=80&fit=crop\"/>\n                        <span class=\"absolute bottom-3 right-3 rounded-full bg-[rgba(44,42,40,.82)] px-2.5 py-1 text-xs font-semibold text-white\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"video duration badge 2\">\n                            6:20\n                        </span>\n                    </div>\n                    <div class=\"p-5\" data-kid=\"1-2-3-2-2-2\" data-name=\"learning article text 2\">\n                        <h3 class=\"cozia-display text-xl leading-tight\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"learning article headline 2\">\n                            Build a tiny weather station\n                        </h3>\n                        <p class=\"mt-2 text-sm text-[var(--muted)]\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"learning article meta 2\">\n                            Experiments · 6 min\n                        </p>\n                    </div>\n                </article>\n                <article class=\"group min-w-[250px] flex-1 overflow-hidden rounded-[18px] bg-white shadow-[0_8px_24px_rgba(44,42,40,.05)] sm:min-w-[270px]\" data-kid=\"1-2-3-2-3\" data-name=\"learning article 3\">\n                    <div class=\"relative aspect-[4/3] overflow-hidden bg-[var(--paper-soft)]\" data-kid=\"1-2-3-2-3-1\" data-name=\"learning article thumbnail container 3\">\n                        <img alt=\"Young girl focused on a creative project, by Tim Mossholder on Unsplash\" class=\"h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"learning article image 3\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1648420325709-47004b23d1f4?auto=format&w=640&q=80&fit=crop\"/>\n                        <span class=\"absolute bottom-3 right-3 rounded-full bg-[rgba(44,42,40,.82)] px-2.5 py-1 text-xs font-semibold text-white\" data-kid=\"1-2-3-2-3-1-2\" data-name=\"video duration badge 3\">\n                            3:45\n                        </span>\n                    </div>\n                    <div class=\"p-5\" data-kid=\"1-2-3-2-3-2\" data-name=\"learning article text 3\">\n                        <h3 class=\"cozia-display text-xl leading-tight\" data-kid=\"1-2-3-2-3-2-1\" data-name=\"learning article headline 3\">\n                            The art of noticing\n                        </h3>\n                        <p class=\"mt-2 text-sm text-[var(--muted)]\" data-kid=\"1-2-3-2-3-2-2\" data-name=\"learning article meta 3\">\n                            Creative practice · 3 min\n                        </p>\n                    </div>\n                </article>\n                <article class=\"group min-w-[250px] flex-1 overflow-hidden rounded-[18px] bg-white shadow-[0_8px_24px_rgba(44,42,40,.05)] sm:min-w-[270px]\" data-kid=\"1-2-3-2-4\" data-name=\"learning article 4\">\n                    <div class=\"relative aspect-[4/3] overflow-hidden bg-[var(--paper-soft)]\" data-kid=\"1-2-3-2-4-1\" data-name=\"learning article thumbnail container 4\">\n                        <img alt=\"Child discovering a new activity, by Tanaphong Toochinda on Unsplash\" class=\"h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]\" data-kid=\"1-2-3-2-4-1-1\" data-name=\"learning article image 4\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1579938202767-771be803237b?auto=format&w=640&q=80&fit=crop\"/>\n                        <span class=\"absolute bottom-3 right-3 rounded-full bg-[rgba(44,42,40,.82)] px-2.5 py-1 text-xs font-semibold text-white\" data-kid=\"1-2-3-2-4-1-2\" data-name=\"video duration badge 4\">\n                            7:10\n                        </span>\n                    </div>\n                    <div class=\"p-5\" data-kid=\"1-2-3-2-4-2\" data-name=\"learning article text 4\">\n                        <h3 class=\"cozia-display text-xl leading-tight\" data-kid=\"1-2-3-2-4-2-1\" data-name=\"learning article headline 4\">\n                            Small questions, big ideas\n                        </h3>\n                        <p class=\"mt-2 text-sm text-[var(--muted)]\" data-kid=\"1-2-3-2-4-2-2\" data-name=\"learning article meta 4\">\n                            For curious families · 7 min\n                        </p>\n                    </div>\n                </article>\n            </div>\n        </section>\n        <section aria-label=\"Cozia trust promise\" class=\"mt-14 flex flex-col gap-4 rounded-[18px] bg-[var(--sage-soft)] px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8\" data-kid=\"1-2-4\" data-name=\"trust promise section\">\n            <div class=\"flex items-start gap-4\" data-kid=\"1-2-4-1\" data-name=\"trust promise content\">\n                <span aria-hidden=\"true\" class=\"mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-lg text-[var(--sage)]\" data-kid=\"1-2-4-1-1\" data-name=\"checkmark icon\">\n                    ✓\n                </span>\n                <div data-kid=\"1-2-4-1-2\" data-name=\"trust promise text group\">\n                    <p class=\"text-sm font-bold text-[var(--ink)]\" data-kid=\"1-2-4-1-2-1\" data-name=\"trust promise title\">\n                        Safe by design\n                    </p>\n                    <p class=\"mt-1 text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-4-1-2-2\" data-name=\"trust promise description\">\n                        Every pick is reviewed for thoughtful, family-friendly viewing before it reaches your shelf.\n                    </p>\n                </div>\n            </div>\n            <a class=\"cozia-focus rounded-lg px-2 py-2 text-sm font-bold text-[var(--sage)] hover:text-[var(--ink)]\" data-kid=\"1-2-4-2\" data-name=\"how it works link\" href=\"#how-it-works\">\n                How Cozia works\n                <span aria-hidden=\"true\" data-kid=\"1-2-4-2-1\" data-name=\"arrow icon\">\n                    →\n                </span>\n            </a>\n        </section>\n        <section aria-labelledby=\"closing-title\" class=\"mt-16 border-t border-[var(--line)] pt-10 sm:flex sm:items-end sm:justify-between\" data-kid=\"1-2-5\" data-name=\"footer community section\" id=\"community\">\n            <div data-kid=\"1-2-5-1\" data-name=\"footer intro text group\">\n                <p class=\"mb-3 text-xs font-bold uppercase tracking-[.16em] text-[var(--ochre)]\" data-kid=\"1-2-5-1-1\" data-name=\"footer pre-headline\">\n                    Stay curious\n                </p>\n                <h2 class=\"cozia-display text-3xl tracking-[-.03em] sm:text-4xl\" data-kid=\"1-2-5-1-2\" data-name=\"footer headline\" id=\"closing-title\">\n                    A calmer corner of the internet.\n                </h2>\n                <p class=\"mt-3 max-w-md text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-5-1-3\" data-name=\"footer description\">\n                    A place to find something good, press play, and make a little room for being together.\n                </p>\n            </div>\n            <div class=\"mt-6 flex flex-wrap gap-x-5 gap-y-3 text-sm font-semibold text-[var(--muted)] sm:mt-0\" data-kid=\"1-2-5-2\" data-name=\"footer utility links\">\n                <a class=\"cozia-focus rounded-lg py-2 hover:text-[var(--ink)]\" data-kid=\"1-2-5-2-1\" data-name=\"about link\" href=\"#about\">\n                    About Cozia\n                </a>\n                <a class=\"cozia-focus rounded-lg py-2 hover:text-[var(--ink)]\" data-kid=\"1-2-5-2-2\" data-name=\"guidelines link\" href=\"#community\">\n                    Community guidelines\n                </a>\n                <a class=\"cozia-focus rounded-lg py-2 hover:text-[var(--ink)]\" data-kid=\"1-2-5-2-3\" data-name=\"privacy link\" href=\"#privacy\">\n                    Privacy\n                </a>\n            </div>\n        </section>\n    </main>\n    <nav aria-label=\"Mobile navigation\" class=\"fixed bottom-0 left-0 right-0 z-40 border-t border-[var(--line)] bg-[rgba(253,251,247,.96)] px-3 py-2 backdrop-blur-xl md:hidden\" data-kid=\"1-3\" data-name=\"mobile navigation bar\">\n        <div class=\"mx-auto flex max-w-md items-center justify-around gap-1\" data-kid=\"1-3-1\" data-name=\"mobile navigation content\">\n            <a class=\"cozia-focus flex min-h-11 min-w-11 flex-col items-center justify-center rounded-xl px-2 text-[12px] font-bold text-[var(--ink)]\" data-kid=\"1-3-1-1\" data-name=\"mobile watch link\" href=\"#watch\">\n                <span aria-hidden=\"true\" class=\"mb-0.5 text-lg\" data-kid=\"1-3-1-1-1\" data-name=\"mobile watch icon\">\n                    ⌂\n                </span>\n                Watch\n            </a>\n            <a class=\"cozia-focus flex min-h-11 min-w-11 flex-col items-center justify-center rounded-xl px-2 text-[12px] font-semibold text-[var(--muted)]\" data-kid=\"1-3-1-2\" data-name=\"mobile live link\" href=\"#shorts\">\n                <span aria-hidden=\"true\" class=\"mb-0.5 text-lg\" data-kid=\"1-3-1-2-1\" data-name=\"mobile live icon\">\n                    ◉\n                </span>\n                Live\n            </a>\n            <a class=\"cozia-focus flex min-h-11 min-w-11 flex-col items-center justify-center rounded-xl px-2 text-[12px] font-semibold text-[var(--muted)]\" data-kid=\"1-3-1-3\" data-name=\"mobile saved link\" href=\"#saved\">\n                <span aria-hidden=\"true\" class=\"mb-0.5 text-lg\" data-kid=\"1-3-1-3-1\" data-name=\"mobile saved icon\">\n                    ♡\n                </span>\n                Saved\n            </a>\n            <a class=\"cozia-focus flex min-h-11 min-w-11 flex-col items-center justify-center rounded-xl px-2 text-[12px] font-semibold text-[var(--muted)]\" data-kid=\"1-3-1-4\" data-name=\"mobile community link\" href=\"#community\">\n                <span aria-hidden=\"true\" class=\"mb-0.5 text-lg\" data-kid=\"1-3-1-4-1\" data-name=\"mobile community icon\">\n                    ☷\n                </span>\n                Community\n            </a>\n            <a class=\"cozia-focus flex min-h-11 min-w-11 flex-col items-center justify-center rounded-xl px-2 text-[12px] font-semibold text-[var(--muted)]\" data-kid=\"1-3-1-5\" data-name=\"mobile profile link\" href=\"#profile\">\n                <span aria-hidden=\"true\" class=\"mb-0.5 text-lg\" data-kid=\"1-3-1-5-1\" data-name=\"mobile profile icon\">\n                    ○\n                </span>\n                Profile\n            </a>\n        </div>\n    </nav>\n</div>\n",
